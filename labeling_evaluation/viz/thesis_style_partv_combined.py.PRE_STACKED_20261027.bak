"""Analysis V.1 (who files) as one figure of two panels (author 2026-10-27): (a) the assignee-type rows of q2_filer_types, (b) the
cumulative share of q2_largest_filers_share, side by side, 16 cm x 7 cm, panel letters 9 pt at the top left of each panel.

Same data, colours and words as the two single figures of viz/thesis_style_partv.py (fig_filer_types, fig_largest_filers_share), which
stay as they are; only the layout changes. Writes to LaTeX_v15/:
    Figures/Part_V_assignees_and_regions/V1_who_files/main/q2_assignees_types_and_concentration.{pdf,png}
    Data_for_writing/csv/q2_assignees_types_and_concentration.csv   (both panels' data, one 'panel' column)
Driver: python3 -m viz.thesis_style_partv_combined
"""
from __future__ import annotations

import matplotlib as mpl
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from matplotlib.lines import Line2D
from matplotlib.patches import Patch
from matplotlib.text import Text

from viz import analysis5 as a5
from viz import config, figcheck, thesis
from viz import thesis_q2 as q2
from viz import thesis_style_partv as sp
from viz.thesis_latex_common import root as latex_root

ts = sp.ts
NAME = "q2_assignees_types_and_concentration"
GROUP, ROLE, PART = "V1_who_files", "main", "Part_V_assignees_and_regions"
CM = 2.54
HEIGHT_CM = 7.0
LETTER_PT = 9
TS = 8.0                     # direct labels: 8 pt, the floor, so the narrowest segment (10.7 %) still holds its value
Y_TOP = 1.16                 # (b) room above 100 % for the key
X_LEFT = 44                  # (b) room left of rank 0 for the 16 % and 29 % marks
WIDTH_RATIOS = [1.3, 1.0]    # (a) wider: its segments carry the values
#: (a) the values inside the segments without the " %" (the axis is in %): with it, 10.7 % of the 2024-26* row does not fit at half width
IN_BAR = "{:.1f}"
WORD_A = dict(sp.ATYPE_WORD, **{"Individual inventor": "individual\ninventor"})   # two lines: one line runs into the university name


def _types(ax, ctx):
    """Panel (a): fig_filer_types drawn into ``ax`` (rows, segment values, the university column, the type names above row 1)."""
    parts, parts_n, bars = q2._filer_types_parts(ctx)
    order = ["Named company", "Individual inventor", "University / institute"]
    sh = parts[order].div(parts[order].sum(axis=1), axis=0)
    rows = [1, 0] + list(range(2, len(bars)))
    labels = ["all designs", "all patents"] + [sp.COHORT[b] for b in bars[2:]]
    ypos = [0, 1] + [2.45 + k for k in range(len(bars) - 2)]
    for y, r in zip(ypos, rows):
        left = 0.0
        inc = bars[r] == sp.INCOMPLETE
        for k in order:
            v = float(sh.loc[r, k])
            ax.barh(y, v, 0.72, left=left, color=sp.ATYPE_COL[k], alpha=sp.INC_ROW_ALPHA if inc else 1.0, edgecolor="white", linewidth=0.6)
            if k != "University / institute" and v >= 0.08:
                col = sp.INK if inc else sp.ATYPE_INK[k]
                ax.text(left + v / 2, y, IN_BAR.format(100 * v), ha="center", va="center", fontsize=TS, color=col)
            left += v
        ax.text(1.03, y, f"{100 * float(sh.loc[r, 'University / institute']):.1f} %", transform=ax.get_yaxis_transform(),
                ha="left", va="center", fontsize=TS, color=sp.ATYPE_TEXT["University / institute"])
    s0 = sh.loc[rows[0]]
    cx = {"Named company": s0["Named company"] / 2, "Individual inventor": s0["Named company"] + s0["Individual inventor"] / 2}
    for k, x in cx.items():
        ax.text(x, -0.62, WORD_A[k], ha="center", va="bottom", fontsize=TS, color=sp.ATYPE_TEXT[k])
    ax.text(1.03, -0.62, sp.ATYPE_WORD["University / institute"], transform=ax.get_yaxis_transform(), ha="left", va="bottom",
            fontsize=TS, color=sp.ATYPE_TEXT["University / institute"])
    ax.set_yticks(ypos, labels)
    ax.set_ylabel("priority-year cohort")
    ax.set_ylim(ypos[-1] + 0.55, -0.62)
    ax.set_xlim(0, 1)
    ax.set_xticks([0, .25, .5, .75, 1], ["0", "25", "50", "75", "100"])
    ax.set_xlabel("share of all designs (%)")
    ax.spines["left"].set_visible(False)
    ax.tick_params(axis="y", length=0)
    return parts.assign(bar=bars, n=parts_n)


def _concentration(ax, ctx):
    """Panel (b): fig_largest_filers_share drawn into ``ax``. At half width: the key in one column at the top left (two columns do not
    fit), in room above 100 % (the y axis drawn to 100 only), so it clears the dashed line; the dashed line's label in three lines in the
    light area under the end of the curve; the x axis starts a little left of 0 so the 16 % and 29 % marks keep their place above-left
    of their dots without crossing the y axis."""
    d = q2._frames(ctx)
    sizes, cov, v = d["sizes"], d["cov"], ctx.v
    n_air, n_named = len(v), len(sizes)
    cum = (sizes.cumsum() / n_air).to_numpy()
    rank = np.arange(1, n_named + 1)
    xs, ys = np.r_[0, rank], np.r_[0, cum]
    edges = [0] + cov["cumulative firms"].astype(int).tolist()
    for k in range(len(edges) - 1):
        sl = slice(edges[k], edges[k + 1] + 1)
        ax.fill_between(xs[sl], 0, ys[sl], step="post", color=sp.BAND_FILL[k], linewidth=0, zorder=1)
    ax.step(xs, ys, where="post", color=ts.ATYPE["Company"], linewidth=1.2, zorder=3, solid_capstyle="butt")
    share_named = float(sizes.sum() / n_air)
    ax.axhline(share_named, color=sp.MUTED, linewidth=0.7, linestyle="--", zorder=2)
    ax.text(n_named - 3, 0.40, f"all {n_named} companies\nand universities:\n{int(sizes.sum())} designs, {sp._pct(share_named)}",
            ha="right", va="top", fontsize=TS, color=sp.MUTED, linespacing=1.15, zorder=4)
    for k, e in enumerate(edges[1:]):
        ax.plot(e, cum[e - 1], "o", color=sp.INK, markersize=4, zorder=5)
        ax.annotate(sp._pct(cum[e - 1]), (e, cum[e - 1]), xytext=(-3, 3), textcoords="offset points",
                    ha="right", va="bottom", fontsize=TS, color=sp.INK, zorder=6)
    names = [f"{int(r['firms'])} assignees with {sp.BAND_DESC[k].replace('designs', 'designs each').replace('1 design', '1 design each')}"
             for k, r in cov.reset_index(drop=True).iterrows()]
    ax.legend(handles=[Patch(facecolor=sp.BAND_FILL[k], edgecolor="none", label=names[k]) for k in range(len(names))],
              loc="upper left", bbox_to_anchor=(0.0, 1.0), ncol=1, frameon=False, fontsize=TS, handlelength=1.2, handleheight=0.9,
              labelspacing=0.25, borderaxespad=0.2, handletextpad=0.5)
    ax.set_xlim(-X_LEFT, n_named + 2)
    ax.set_ylim(0, Y_TOP)
    ax.spines["left"].set_bounds(0, 1)
    ax.spines["bottom"].set_bounds(0, n_named)
    ax.set_yticks([0, .2, .4, .6, .8, 1], ["0", "20", "40", "60", "80", "100"])
    ax.set_xticks([0, 50, 100, 150, n_named])
    ax.set_ylabel(f"cumulative share of\nall {n_air} designs (%)")
    ax.set_xlabel("companies and universities ranked\nby designs, largest first")
    return pd.DataFrame({"rank": rank, "firm": sizes.index, "unique aircraft": sizes.to_numpy(), "cumulative share": np.round(cum, 4)})


def fig_types_and_concentration(ctx):
    """The two panels side by side, 6.3 in (16 cm) x 7 cm; each panel a subfigure so its letter sits at its own top left corner and
    constrained layout keeps room for it. Returns (fig, data) with data = both panels' rows, a 'panel' column first."""
    with sp._rc():
        fig = plt.figure(figsize=(ts.TEXTWIDTH, HEIGHT_CM / CM), layout="constrained")
        sfa, sfb = fig.subfigures(1, 2, width_ratios=WIDTH_RATIOS, wspace=0.02)
        da = _types(sfa.subplots(), ctx)
        db = _concentration(sfb.subplots(), ctx)
        for sf, letter in ((sfa, "(a)"), (sfb, "(b)")):
            sf.suptitle(letter, x=0.0, ha="left", fontsize=LETTER_PT, fontfamily=ts.SANS, fontweight="normal")
        sfa.legend(handles=[Line2D([], [], linestyle="none", label=ts.INCOMPLETE_LABEL)], loc="outside lower left", frameon=False,
                   handlelength=0, handletextpad=0, fontsize=TS)      # the asterisk rule of (a), one line under (a) only
    data = pd.concat([da.reset_index(drop=True).assign(panel="(a) assignee types"),
                      db.assign(panel="(b) cumulative share of the largest")], ignore_index=True)
    for c in data.columns:                               # counts stay whole numbers where the other panel leaves them blank
        if c != "cumulative share" and pd.api.types.is_float_dtype(data[c]) and (data[c].dropna() % 1 == 0).all():
            data[c] = data[c].astype("Int64")
    return fig, data[["panel"] + [c for c in data.columns if c != "panel"]]


def export(cfg=None, ctx=None) -> dict:
    """Build, check (6.3 in wide, nothing under 8 pt: ts.save) and write the pdf, png and csv; returns the facts to print."""
    cfg = cfg or config.load(strict=False)
    ctx = ctx or thesis.context(cfg)
    root = latex_root(cfg)
    pdf = root / "Figures" / PART / GROUP / ROLE / f"{NAME}.pdf"
    csv = root / "Data_for_writing" / "csv" / f"{NAME}.csv"
    csv.parent.mkdir(parents=True, exist_ok=True)
    with mpl.rc_context(ts.RC):
        fig, data = fig_types_and_concentration(ctx)
        ts.save(fig, NAME, pdf.parent)
    a5.relabel_df(data).to_csv(csv, index=False)
    info = dict(name=NAME, pdf=pdf, png=pdf.with_suffix(".png"), csv=csv, width_cm=round(fig.get_figwidth() * CM, 2),
                height_cm=round(fig.get_figheight() * CM, 2), overlaps=figcheck.overlaps(fig),
                smallest_pt=min(t.get_fontsize() for t in fig.findobj(Text) if t.get_text().strip()))
    plt.close(fig)
    return info


if __name__ == "__main__":
    i = export()
    print(i["pdf"], "\n", i["csv"], "\n", i["width_cm"], "x", i["height_cm"], "cm | smallest", i["smallest_pt"], "pt | overlaps", i["overlaps"])
