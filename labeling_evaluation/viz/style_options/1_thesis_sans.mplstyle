# 1. Your current thesis style: Arial-type sans (Liberation Sans here), 9 pt, light horizontal grid
font.family: sans-serif
font.sans-serif: Arial, Helvetica, Liberation Sans, TeX Gyre Heros
font.size: 9
axes.labelsize: 9
axes.titlesize: 9
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8
legend.frameon: False
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
grid.color: 0.9
grid.linewidth: 0.6
axes.linewidth: 0.6
xtick.major.width: 0.6
ytick.major.width: 0.6
lines.linewidth: 1.6
savefig.bbox: tight
pdf.fonttype: 42
