"""Analysis III, one pass: the Spearman table of the architecture shares (III.1), the weights of condition 3, the three-year
check of condition 1, the granted-and-live base of F, and III.4 (condition 1 and 2 on the five directory categories).

Drawn and written by notebook 52 through viz/thesis_v2_part3.py.
Reuses viz.thesis_q7 / viz.thesis_q6 builders, lib.dominant_design and viz.frames; no method of them is changed.
"""
from __future__ import annotations

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from matplotlib.lines import Line2D
from matplotlib.patches import Patch
from scipy import stats

from lib import dominant_design as dd
from lib.multiple import holm
from viz import config, frames, plots, style, thesis, thesis_q6, thesis_q7

RUN3 = 3


def runs(years, k: int) -> list:
    """Years that sit in a run of at least ``k`` consecutive years (k = 2 is :func:`lib.dominant_design.condition1_years`)."""
    ys = sorted(int(y) for y in years)
    out, cur = set(), []
    for y in ys:
        cur = cur + [y] if cur and y == cur[-1] + 1 else [y]
        if len(cur) >= k:
            out.update(cur)
    return sorted(out)


# ---- III.1
#: first year of the late-years Spearman test (handoff 2026-10-15): 2016 to the last complete year, one point per year
RHO_LATE_FIRST = 2016


def rho_table(ctx, v: pd.DataFrame | None = None, codes=None) -> pd.DataFrame:
    """Spearman rho and p of each architecture's share of the year's aircraft on the priority year (2008 to the last complete
    year), architectures with 20 aircraft or more over those years; all unique aircraft with an architecture recorded. Each p column
    has its Holm-adjusted column beside it, one family per column (the architectures tested over that span).
    ``v``: another set of designs (default ctx.v); ``codes``: test exactly these architectures instead of those with 20 or more
    (the follow-up without Bell / Textron keeps the III.1 family, viz/followup_iii1.py)."""
    v = ctx.v if v is None else v
    last = ctx.cfg.analysis["last_complete_year"]
    w = v[v["topType"].notna() & v["year"].between(frames.DD_YEAR_FIRST, last)]
    cnt = pd.crosstab(w["year"], w["topType"])
    share = cnt.div(cnt.sum(axis=1), axis=0)
    rows = []
    for c in cnt.columns:
        n = int(cnt[c].sum())
        if (n < 20) if codes is None else (c not in codes):
            continue
        r, p = stats.spearmanr(share.index, share[c])
        ok = cnt.sum(axis=1) >= frames.DD_YEAR_MIN
        r2, p2 = stats.spearmanr(share.index[ok], share.loc[ok, c]) if ok.sum() > 3 else (np.nan, np.nan)
        late = (share.index >= RHO_LATE_FIRST) & (share.index <= last)      # the same yearly shares, 2016 to the last complete year only
        r3, p3 = stats.spearmanr(share.index[late], share.loc[late, c])
        rows.append({"code": c, "architecture": style.cls(c).name, "aircraft": n, "years": len(share), "rho": round(float(r), 3),
                     "p": float(p), "rho, years with 20+ aircraft": round(float(r2), 3), "p, years with 20+ aircraft": float(p2),
                     "years with 20+ aircraft": int(ok.sum()), "rho, 2016-23": round(float(r3), 3), "p, 2016-23": float(p3)})
    t = pd.DataFrame(rows)
    # Holm within each family (supervisor review 2, 2026-10): the architectures' p values of one span are one family
    for col in ("p", "p, years with 20+ aircraft", "p, 2016-23"):
        t.insert(t.columns.get_loc(col) + 1, f"{col} (Holm)", holm(t[col]))
    first = {"SLC": 0, "TR": 1}
    t = t.assign(_o=t["code"].map(first).fillna(2)).sort_values(["_o", "aircraft"], ascending=[True, False]).drop(columns="_o")
    return t.reset_index(drop=True)


# ---- condition 3 weights
def weights_report(ctx) -> dict:
    """The weights table of the main weighting (w15: 15 dimensions, each of the four systems weighing 1) and the frame it reads."""
    fi = frames.gower_inputs(ctx.ds)
    return {"table": frames.form_weights_table(fi.weighting), "n_fields": len(fi.fields), "n_aircraft": len(fi.frame),
            "numeric": sorted(fi.numeric), "sets": sorted(fi.sets), "weighting": fi.weighting}


# ---- condition 3 on F, three bases
def form_family(ctx) -> pd.DataFrame:
    """Condition 3 on F: Q of the form distance per cohort against the two earliest cohorts and its permutation band, on the designs of F's
    base (an architecture recorded, as at A: Q uses no architecture, F only regroups the designs), for the actively protected designs, all
    designs and the granted-and-live designs. A fresh generator (seed) per base; the same weights as :func:`weights_report` (w15)."""
    ds, v = ctx.ds, ctx.v
    D, frame = frames.form_distance(ds)
    at = {a: i for i, a in enumerate(frame["aircraft_id"].to_numpy())}
    state = frames.patent_state(ds, v)
    f = frames.dd_level_keys(ds, v)["family_b"]
    out = []
    for base, st in (("actively protected", "in_force"), ("all designs", None), ("granted and live", "granted_live")):
        m = f.notna() & v["window"].notna()
        if st:
            m &= v["aircraft_id"].map(state[st]).astype(bool)
        sub = v[m].copy()
        sub["row"] = sub["aircraft_id"].map(at)
        sub = sub[sub["row"].notna()]
        t = dd.cohesion_band(D, sub["row"].astype(int).to_numpy(), sub["window"].to_numpy(), ctx.WIN_NAMES, perms=thesis_q7.PERMS, seed=ctx.SEED)
        t.insert(0, "base", base)
        out.append(t)
    t = pd.concat(out, ignore_index=True).rename(columns={"window": "cohort", "aircraft": "designs", "Q of the earliest windows": "Q of the earliest cohorts"})
    t["partial"] = t["cohort"].astype(str).str.contains("partial")
    return t


def form_ap_vs_all(ctx, cohort: str = "2020-23") -> pd.DataFrame:
    """Condition 3 of the actively protected designs of ``cohort`` against the ALL-DESIGNS baseline (dissertation §3.4.4, III.2): Q of the
    actively protected designs of the cohort; baseline = pooled Q of the two earliest cohorts of all designs (cohesion_band's reference);
    band: the all designs shuffled (thesis_q7.PERMS times, a fresh default_rng(seed) per level), cut into blocks of the all-designs cohort
    sizes except ``cohort``, which takes the size of its actively protected cohort; ΔQ* = Q* of that block - mean Q* of the two earliest
    blocks, band = percentiles 2.5 / 97.5. At A, A·W·T, A·U (frames.archetype_key) and F (= A: Q uses no architecture), w15."""
    ds, v = ctx.ds, ctx.v
    D, frame = frames.form_distance(ds, frames.Q_WEIGHTINGS[0])
    at = {a: i for i, a in enumerate(frame["aircraft_id"].to_numpy())}
    live = v["aircraft_id"].map(frames.patent_state(ds, v)["in_force"]).astype(bool)
    base_w = list(ctx.WIN_NAMES)[:2]
    out = []
    for lvl in ("A0", "A1t", "A0c"):
        sub = v[frames.archetype_key(v, lvl).notna()].dropna(subset=["window"]).copy()
        sub["row"] = sub["aircraft_id"].map(at)
        sub = sub[sub["row"].notna()]
        rows, win, ap = sub["row"].astype(int).to_numpy(), sub["window"].to_numpy(), live[sub.index].to_numpy()
        per = {w: rows[win == w] for w in ctx.WIN_NAMES}
        ref = float(np.mean([dd.mean_pairwise_distance(D, per[w]) for w in base_w]))
        tgt = rows[(win == cohort) & ap]
        q = dd.mean_pairwise_distance(D, tgt)
        sizes = {w: (len(tgt) if w == cohort else len(per[w])) for w in ctx.WIN_NAMES}
        rng, band = np.random.default_rng(ctx.SEED), []
        for _ in range(thesis_q7.PERMS):
            sh, cut, drawn = rng.permutation(rows), 0, {}
            for w in ctx.WIN_NAMES:
                drawn[w] = dd.mean_pairwise_distance(D, sh[cut:cut + sizes[w]])
                cut += sizes[w]
            band.append(drawn[cohort] - np.mean([drawn[w] for w in base_w]))
        lo, hi = float(np.percentile(band, 2.5)), float(np.percentile(band, 97.5))
        out.append({"level": _LVL[lvl], "cohort": cohort, "actively protected designs": int(len(tgt)), "Q": round(q, 4),
                    "baseline (all designs, two earliest cohorts)": round(ref, 4), "ΔQ": round(q - ref, 4),
                    "band low": round(lo, 4), "band high": round(hi, 4), "below band": bool(q - ref < lo)})
    f = dict(out[0], level=_LVL["family_b"])
    return pd.DataFrame(out + [f])


# ---- the verdict on each base, never mixed (results freeze 2026-10-14)
_BASE_DY = {"all designs": "all", "actively protected": "in force"}
_LVL = {"A0": "A", "A1t": "A·W·T", "A0c": "A·U", "family_b": "F"}


def _base_frames(ctx):
    """Condition 2 and 3 frames on each base: all designs (thesis_q7's own) and the actively protected designs (the same functions on that subset)."""
    key = id(ctx)
    if getattr(ctx, "_a3_bases", None) is not None:
        return ctx._a3_bases
    d = thesis_q7._data(ctx)
    v = ctx.v
    live = v["aircraft_id"].map(frames.patent_state(ctx.ds, v)["in_force"]).astype(bool)
    vp = v[live]
    out = {"all designs": (d["bal"], d["form"]),
           "actively protected": (frames.dd_balance_table(ctx.ds, vp, ctx.WIN_NAMES, ctx.cfg.analysis["rarefy_n"], thesis_q7.PERMS, ctx.SEED),
                                  frames.dd_form_table(ctx.ds, vp, ctx.WIN_NAMES, thesis_q7.PERMS, ctx.SEED))}
    ctx._a3_bases = out
    return out


def verdict_two_bases(ctx):
    """The verdict per base (all designs = the main reading; actively protected = sensitivity), each condition read on the SAME base,
    and the numbers behind it. Returns (verdict table, detail table)."""
    frames.set_window_bounds(ctx.cfg)
    d = thesis_q7._data(ctx)
    dy = d["dy"]
    complete = [w for w in ctx.WIN_NAMES if "partial" not in w]
    wof = lambda yy: next(w for w, lo, hi in frames._WIN_BOUNDS if lo <= yy <= hi)      # noqa: E731
    main = frames.Q_WEIGHTINGS[0]
    pc = lambda x: f"{100 * x:.1f} %"                                                   # noqa: E731
    rows, det = [], []
    for base, (bal, form) in _base_frames(ctx).items():
        cells = {}
        for lvl, name in _LVL.items():
            y = dy[dy["level id"].eq(lvl) & dy["base"].eq(_BASE_DY[base])]
            b = y[y["read"].astype(bool)]
            yrs = sorted(dd.condition1_years(y))
            sh = dict(zip(b["priority year"].astype(int), b["its share"].astype(float)))
            nn = dict(zip(b["priority year"].astype(int), b["aircraft"].astype(int)))
            top = b.loc[b["its share"].astype(float).idxmax()]
            c1 = ("✓ met in " + " and ".join(map(str, yrs)) + " (" + ", ".join(pc(sh[x]) for x in yrs) + ")") if yrs else \
                 f"✗ not met, at most {pc(float(top['its share']))} ({int(top['priority year'])})"
            bl = bal[bal["level"].eq(lvl) & bal["window"].isin(complete)]
            below2 = bl[bl["below band"].astype(str).eq("True")]["window"].tolist()
            fm = form[form["level"].eq(lvl) & form["weighting"].eq(main) & form["window"].isin(complete)]
            below3 = fm[fm["below band"].astype(str).eq("True")]["window"].tolist()
            inside = dd.all_three_windows(set(yrs), set(below2), set(below3), wof)
            cells[name] = {"1": c1, "2": ("✓ met in " + ", ".join(below2)) if below2 else "✗ not met",
                           "3": ("✓ met in " + ", ".join(below3)) if below3 else "✗ not met",
                           "all": ("✓ met in " + ", ".join(inside)) if inside else "✗ not met"}
            r = {"base": base, "level": name, "condition 1: largest share": pc(float(top["its share"])),
                 "condition 1: its year": int(top["priority year"]), "condition 1: years met": ", ".join(map(str, yrs)) or "none",
                 "condition 1: share 2020 (n of N)": (f"{pc(sh[2020])} ({int(round(sh[2020] * nn[2020]))} of {nn[2020]})" if 2020 in sh else "not read"),
                 "condition 1: share 2021 (n of N)": (f"{pc(sh[2021])} ({int(round(sh[2021] * nn[2021]))} of {nn[2021]})" if 2021 in sh else "not read")}
            for w in complete:
                q = bl[bl["window"].eq(w)]
                r[f"²D {w}"] = float(q["D2"].iloc[0]) if len(q) else np.nan
                r[f"²D lower band edge {w}"] = float(q["D2 permutation low"].iloc[0]) if len(q) else np.nan
            q = fm[fm["window"].eq("2020-23")]
            r["ΔQ 2020-23"] = float(q["ΔQ"].iloc[0])
            r["ΔQ lower band edge 2020-23"] = float(q["ΔQ permutation low"].iloc[0])
            det.append(r)
        for cond, label in (("1", "1, counts: one architecture above 50 % of the designs, two consecutive priority years"),
                            ("2", "2, balance: ²D below the permutation band"),
                            ("3", "3, form: Q below the two earliest cohorts by more than the band"),
                            ("all", "all three in the same period")):
            rows.append({"base": base, "condition": label, **{n: cells[n][cond] for n in _LVL.values()}})
    return pd.DataFrame(rows), pd.DataFrame(det)


# ---- item 4: three consecutive years on the in-force base
def three_year(d) -> dict:
    dy, fy = d["dy"], d["fy"]
    out = {}
    for lvl, name in (("A0", "A"), ("A1t", "A·W·T"), ("A0c", "A·U")):
        y = dy[(dy["level id"] == lvl) & (dy["base"] == "in force") & dy["read"].astype(bool)]
        out[name] = runs(y[y["above 50 %"].astype(bool)]["priority year"], RUN3)
    out["F"] = runs(fy[fy["read, in force"].astype(bool) & (fy["F share in force"] > 0.5)]["priority year"], RUN3)
    return out


# ---- item 5: granted and live
def granted_live(ctx, d) -> dict:
    ds, v = ctx.ds, ctx.v
    state = frames.patent_state(ds, v)
    f = frames.dd_level_keys(ds, v)["family_b"]
    gl = v["aircraft_id"].map(state["granted_live"]).astype(bool)
    m = f.notna() & gl
    last = ctx.cfg.analysis["last_complete_year"]
    yearly = []
    for y in range(frames.DD_YEAR_FIRST, last + 1):
        s = f[m & v["year"].eq(y)]
        k = int((s == frames.FAMILY_LABEL).sum())
        yearly.append({"priority year": y, "aircraft": len(s), "F aircraft": k, "F share": k / len(s) if len(s) else np.nan,
                       "read": len(s) >= frames.DD_YEAR_MIN})
    y = pd.DataFrame(yearly)
    over = y[y["read"] & (y["F share"] > 0.5)]
    met = runs(over["priority year"], 2)
    w0 = v[m].dropna(subset=["window"])
    bal = dd.balance_band(f[w0.index], w0["window"], ctx.WIN_NAMES, n=ctx.cfg.analysis["rarefy_n"], perms=thesis_q7.PERMS, seed=ctx.SEED)
    return {"yearly": y, "met": met, "balance": bal}


# ---- item 6: directory categories
def directory(ctx, d) -> dict:
    ds, v = ctx.ds, ctx.v
    state = frames.patent_state(ds, v)
    k = v["class5"].where(v["topType"].notna())
    live = v["aircraft_id"].map(state["in_force"]).astype(bool)
    last = ctx.cfg.analysis["last_complete_year"]
    yrs = range(frames.DD_YEAR_FIRST, last + 1)
    res = {}
    for base, mask in (("in force", live & k.notna()), ("all", k.notna())):
        t = dd.yearly_top_share(k[mask], v.loc[mask, "year"], yrs, frames.DD_YEAR_MIN)
        res[base] = t
    met = sorted(dd.condition1_years(res["in force"]))
    met_all = sorted(dd.condition1_years(res["all"]))
    w0 = v[k.notna()].dropna(subset=["window"])
    bal = dd.balance_band(k[w0.index], w0["window"], ctx.WIN_NAMES, n=ctx.cfg.analysis["rarefy_n"], perms=thesis_q7.PERMS, seed=ctx.SEED)
    return {"yearly": res, "met": met, "met_all": met_all, "balance": bal, "counts": k.value_counts().to_dict()}


def fig_directory(ctx, r):
    win = ctx.WIN_NAMES
    bal = r["balance"].set_index("window").reindex(win)
    fig, (a1, a2) = plt.subplots(1, 2, figsize=(ctx.W, 3.2), constrained_layout=True)
    fi, fa = r["yearly"]["in force"].set_index("priority year"), r["yearly"]["all"].set_index("priority year")
    yrs = fi.index.to_numpy()
    rd_i, rd_a = fi["read"].to_numpy(bool), fa["read"].to_numpy(bool)
    first = int(yrs[rd_i][0])
    plots.condition1_years(a1, yrs, fi["its share"], fa["its share"], rd_i, rd_a, r["met"], first, "")
    a1.set_ylim(0, 1.05)
    a1.text((yrs[0] + first - 1) / 2, 0.05, f"under {frames.DD_YEAR_MIN} aircraft:\nnot read", ha="center", va="bottom", fontsize=7, color=style.MUTED)
    a1.set_xticks(yrs, [str(y)[2:] for y in yrs], fontsize=7)
    a1.set_xlabel("priority year", fontsize=7.5)
    a1.set_ylabel(f"share of the year's aircraft in the\nlargest category ({r['yearly']['in force']['largest archetype'].mode().iloc[0]})", fontsize=7.5)
    a1.set_title("Condition 1", fontsize=7.5, loc="left")
    a1.text(yrs[-1] + 0.5, 0.505, "50 %", ha="right", va="bottom", fontsize=7.5)
    partial = ["partial" in w for w in win]
    metw = [bool(bal.loc[w, "below band"]) and "partial" not in w for w in win]
    plots.balance_panel(a2, bal.reset_index(), partial, metw, [plots.WINDOW_TICKS[w] for w in win])
    a2.set_ylabel("²D: large designs in play", fontsize=7.5)
    a2.set_xlabel("priority cohort", fontsize=7.5)
    a2.set_title("Condition 2", fontsize=7.5, loc="left")
    fig.legend(handles=[Line2D([], [], color=style.INK, linewidth=1.7, marker="o", markersize=4.4, label="actively protected aircraft"),
                        Line2D([], [], color=style.MUTED, linewidth=1.2, linestyle="--", marker="s", markersize=4.2, markerfacecolor="white", label="all aircraft"),
                        Patch(facecolor="#dedcd8", label="permutation band (95 %)"),
                        Line2D([], [], color=style.INK, marker="o", markersize=3.6, linewidth=1.3, label=f"²D rarefied to {ctx.cfg.analysis['rarefy_n']}")],
               loc="outside lower center", ncol=4, fontsize=7.5, handlelength=1.8, columnspacing=1.2)
    return fig
