#: the dimensions the linked-aircraft subset is tested on, and how each one is compared
LINKED_CATEGORICAL = [("folded class", "class5"), ("applicant region", "region3"),
                      ("priority window", "window"), ("filer type", "filer")]
LINKED_CONTINUOUS = [("priority year", "year"), ("propulsive units", "units")]


def linked_representativeness(v: pd.DataFrame) -> pd.DataFrame:
    """Are the aircraft linked to an evtol.news page a fair picture of the whole analysis set?

    Section 2.5 describes the linked aircraft only, and the author's ruling of 2026-09-23 is that
    the section is worth nothing unless those aircraft stand for the rest ("it is only valid if the
    95 that you chose ... are representative of my own data set, and we need to state this very
    well"). The link is not a random draw: an aircraft can only be linked when the labelling gave it
    a real name **and** a public directory of announced eVTOL programmes carries that name, so the
    subset is by construction the publicly announced part of the corpus. This tests it rather than
    assuming it, one row per level of the compared attribute plus one row per continuous one:
    the share inside the linked set, the share in everything else, the gap, and a per-attribute
    chi-square (categorical) or Mann-Whitney (continuous), printed on the attribute's first row.
    """
    from scipy.stats import chi2_contingency, mannwhitneyu
    w = v.copy()
    linked_ids = set(linked_aircraft(v)["aircraft_id"])
    w["_linked"] = w["aircraft_id"].isin(linked_ids)
    n_in, n_out = int(w["_linked"].sum()), int((~w["_linked"]).sum())
    rows = []
    for name, col in LINKED_CATEGORICAL:
        a, b = w.loc[w["_linked"], col], w.loc[~w["_linked"], col]
        levels = list(pd.concat([a, b]).dropna().value_counts().index)
        if col == "window":
            levels = [x for x in WINDOW_NAMES if x in levels]
        ca, cb = a.value_counts().reindex(levels).fillna(0), b.value_counts().reindex(levels).fillna(0)
        obs = np.vstack([ca.to_numpy(), cb.to_numpy()])
        obs = obs[:, obs.sum(axis=0) > 0]
        try:
            p = float(chi2_contingency(obs)[1])
        except Exception:
            p = float("nan")
        gap = float(np.abs(ca / max(len(a), 1) - cb / max(len(b), 1)).sum() / 2)
        for k, lev in enumerate(levels):
            rows.append({"attribute": name, "level": str(lev),
                         "linked": int(ca[lev]), "linked %": round(float(ca[lev]) / max(len(a), 1) * 100, 1),
                         "rest": int(cb[lev]), "rest %": round(float(cb[lev]) / max(len(b), 1) * 100, 1),
                         "gap pp": round(float(ca[lev]) / max(len(a), 1) * 100 - float(cb[lev]) / max(len(b), 1) * 100, 1),
                         "test": "chi-square" if k == 0 else "",
                         "p": round(p, 4) if k == 0 else np.nan,
                         "total variation distance": round(gap, 3) if k == 0 else np.nan,
                         "verdict": ("the linked set matches the rest" if p >= 0.05 else
                                     "the linked set does NOT match the rest") if k == 0 else ""})
    for name, col in LINKED_CONTINUOUS:
        a = pd.to_numeric(w.loc[w["_linked"], col], errors="coerce").dropna()
        b = pd.to_numeric(w.loc[~w["_linked"], col], errors="coerce").dropna()
        try:
            p = float(mannwhitneyu(a, b)[1])
        except Exception:
            p = float("nan")
        rows.append({"attribute": name, "level": "median", "linked": len(a), "linked %": round(float(a.median()), 1),
                     "rest": len(b), "rest %": round(float(b.median()), 1),
                     "gap pp": round(float(a.median() - b.median()), 1), "test": "Mann-Whitney",
                     "p": round(p, 6), "total variation distance": np.nan,
                     "verdict": ("the linked set matches the rest" if p >= 0.05
                                 else "the linked set does NOT match the rest")})
    out = pd.DataFrame(rows)
    out.attrs.update({"linked": n_in, "rest": n_out, "total": n_in + n_out})
    return out


def mission_tables(linked: pd.DataFrame) -> Dict[str, pd.DataFrame]:
    """Crosstabs of each mission field against the folded class, counts, on the linked aircraft."""
    out = {}
    order5 = ["VT", "LC", "WM", "ER", "HB"]
    for field, order in MISSION_ORDER.items():
        t = pd.crosstab(linked[field], linked["class5"]).reindex(index=[o for o in order if o in linked[field].values],
                                                                  columns=[c for c in order5 if c in linked["class5"].values], fill_value=0)
        t["all"] = t.sum(axis=1)
        out[field] = t.reset_index()
    agree = pd.crosstab(linked["class5"], linked["evtol class"]).reindex(index=[c for c in order5 if c in linked["class5"].values])
    agree.index = [f"G1 folded: {FOLD5_NAMES[c]}" for c in agree.index]
    out["agreement"] = agree.reset_index().rename(columns={"index": "patent label"})
    return out



