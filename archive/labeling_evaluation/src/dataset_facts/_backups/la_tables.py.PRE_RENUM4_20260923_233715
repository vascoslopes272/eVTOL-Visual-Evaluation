def firm_tiers(v: pd.DataFrame) -> pd.DataFrame:
    sizes = firm_sizes(v)
    total = len(v)
    rows = []
    for rule, k in (("10 or more aircraft", 10), ("5 or more aircraft", 5), ("4 or more aircraft", 4),
                    ("3 or more aircraft", 3), ("2 or more aircraft", 2), ("all named companies", 1)):
        sel = sizes[sizes >= k]
        rows.append({"rule": rule, "firms": int(len(sel)), "aircraft": int(sel.sum()),
                     "share of the analysis set": round(float(sel.sum() / total), 2),
                     "share of named-company aircraft": round(float(sel.sum() / sizes.sum()), 2)})
    for name, key in (("of which universities / institutes", "University / institute"),
                      ("individual inventors", "Individual inventor"),
                      ("no assignee named on the patent", NO_ASSIGNEE)):
        k = int(v["filer"].eq(key).sum())
        rows.append({"rule": name, "firms": "", "aircraft": k,
                     "share of the analysis set": round(k / total, 2), "share of named-company aircraft": ""})
    return pd.DataFrame(rows)


def firm_frame(v: pd.DataFrame) -> pd.DataFrame:
    """One row per named firm: aircraft, representative patents, distinct classes, first and last
    priority year, windows active, region — the frame the coverage and market-standing readings
    of 1.2.1 are taken on. Index is the canonical company."""
    w = v[v["named"]]
    yrs = w.groupby("company_canonical")["year"]
    f = pd.DataFrame({
        "unique aircraft": firm_sizes(v),
        "patents": w.groupby("company_canonical")["patent_id"].nunique(),
        "distinct classes": w.groupby("company_canonical")["topType"].nunique(),
        "first priority year": yrs.min(),
        "last priority year": yrs.max(),
        "windows active": w.dropna(subset=["window"]).groupby("company_canonical")["window"].nunique(),
    })
    f["years first to last"] = f["last priority year"] - f["first priority year"]
    f["classes per aircraft"] = (f["distinct classes"] / f["unique aircraft"]).round(3)
    f["region"] = firm_region(v).reindex(f.index)
    f["on the AAM index"] = f.index.isin(ari_listed(v))
    return f.sort_values("unique aircraft", ascending=False)


def market_vs_patents(v: pd.DataFrame) -> pd.DataFrame:
    """Does market standing track patenting? The named firms the AAM Reality Index rates against
    the named firms it does not, measure by measure, plus the two correlations taken inside the
    index itself. Mann-Whitney U between the two groups (two-sided, the only test used), Spearman
    rho within the index. Descriptive: every n is printed beside the number.

    The first block answers "do the firms the market rates hold more, file earlier, file broader";
    the second answers "does WHERE a firm sits on the index track any of that".
    """
    from scipy.stats import mannwhitneyu, spearmanr
    f = firm_frame(v)
    listed, rest = f[f["on the AAM index"]], f[~f["on the AAM index"]]
    n_l, n_r = len(listed), len(rest)
    rows: List[Dict] = []

    def med(s):
        return f"{s.median():.4g}"

    def block(col, label, sub=None, fmt=med):
        a, b = (sub if sub is not None else f).pipe(
            lambda d: (d.loc[d["on the AAM index"], col].dropna(), d.loc[~d["on the AAM index"], col].dropna()))
        u, p = mannwhitneyu(a, b, alternative="two-sided")
        rows.append({"reading": label,
                     "AAM index firms": f"{fmt(a)} (n {len(a)})",
                     "other named firms": f"{fmt(b)} (n {len(b)})",
                     "test": f"Mann-Whitney p = {p:.3f}",
                     "p": round(float(p), 3)})

    tot = len(v)
    rows.append({"reading": "aircraft held, and their share of the analysis set",
                 "AAM index firms": f"{int(listed['unique aircraft'].sum())} ({listed['unique aircraft'].sum() / tot:.0%})",
                 "other named firms": f"{int(rest['unique aircraft'].sum())} ({rest['unique aircraft'].sum() / tot:.0%})",
                 "test": f"{n_l} firms against {n_r}", "p": np.nan})
    block("unique aircraft", "unique aircraft per firm, median")
    block("patents", "representative patents per firm, median")
    block("first priority year", "first priority year, median")
    block("distinct classes", "distinct classes per firm, median")
    block("classes per aircraft", "distinct classes per aircraft, median (firms with 2+ aircraft only)",
          sub=f[f["unique aircraft"] >= 2], fmt=lambda s: f"{s.median():.2f}")
    block("years first to last", "years from first to last filing, median")

    # inside the index: does the position on it track anything?
    a = ari_firms(v).set_index("company")
    a["funding"] = pd.to_numeric(a["funding $M"].astype(str).str.replace(",", ""), errors="coerce")
    join = f.join(a[["ARI score", "funding"]], how="inner")
    for x, y, label in (("ARI score", "unique aircraft", "index score against unique aircraft"),
                        ("ARI score", "distinct classes", "index score against distinct classes"),
                        ("funding", "unique aircraft", "disclosed funding against unique aircraft"),
                        ("funding", "first priority year", "disclosed funding against first priority year")):
        d = join[[x, y]].apply(pd.to_numeric, errors="coerce").dropna()
        if len(d) >= 4:
            rho, p = spearmanr(d[x], d[y])
            rows.append({"reading": f"within the index — {label}",
                         "AAM index firms": f"rho {rho:+.2f} (n {len(d)})", "other named firms": "not listed",
                         "test": f"Spearman p = {p:.3f}", "p": round(float(p), 3)})
    return pd.DataFrame(rows)


def coverage_segments(v: pd.DataFrame) -> pd.DataFrame:
    """The firm-size ranking cut into the segments the coverage curve marks: between two
    thresholds, how many firms sit there and how many aircraft they hold. The segments are
    disjoint, so they add up — unlike the nested rows of :func:`firm_tiers`."""
    sizes = firm_sizes(v)
    total = len(v)
    # four bands, not the six nested rows of firm_tiers: they have to be readable side by side on
    # the curve, and at four the reading is plain — three firms hold as many aircraft as the next
    # fourteen, which hold as many as the next thirty-eight.
    cuts = [10, 5, 2, 1]
    rows = []
    for hi, lo in zip([None] + cuts[:-1], cuts):
        sel = sizes[(sizes >= lo) & ((sizes < hi) if hi else True)]
        if not len(sel):
            continue
        band = f"{lo} or more" if hi is None else (f"{lo}" if lo == hi - 1 else f"{lo}-{hi - 1}")
        rows.append({"aircraft per firm": band, "firms": int(len(sel)), "aircraft": int(sel.sum()),
                     "share of the analysis set": round(float(sel.sum() / total), 3),
                     "cumulative firms": int((sizes >= lo).sum()),
                     "cumulative aircraft": int(sizes[sizes >= lo].sum())})
    return pd.DataFrame(rows)


def filer_mix(v: pd.DataFrame) -> pd.DataFrame:
    """Who filed, counted in both units at once: primary patents and the share of them, unique
    aircraft and the share of them, and the aircraft a filer type gets out of one patent. The
    patent columns reproduce the Preliminary Analysis table; the aircraft columns are what makes
    the two denominators of this chapter comparable (author's request, 2026-09-23)."""
    pat = v.drop_duplicates("patent_id")
    order = list(FILER_TYPES)
    names = {"Named company": "Named companies", "University / institute": "Universities and institutes",
             "Individual inventor": "Individual inventors", NO_ASSIGNEE: "No assignee named"}
    rows = []
    for k in order:
        p, a = int(pat["filer"].eq(k).sum()), int(v["filer"].eq(k).sum())
        if not (p or a):
            continue
        rows.append({"filer": names[k],
                     "distinct filers": (int(v.loc[v["filer"].eq(k), "company_canonical"].nunique())
                                         if k in ("Named company", "University / institute") else "not identified"),
                     "primary patents": p, "share per primary patent": round(p / len(pat), 2),
                     "unique aircraft": a, "share of the analysis set": round(a / len(v), 2),
                     "aircraft per patent": round(a / p, 2) if p else np.nan})
    out = pd.DataFrame(rows)
    out.loc[len(out)] = {"filer": "all filers", "distinct filers": "",
                         "primary patents": int(len(pat)), "share per primary patent": 1.0,
                         "unique aircraft": int(len(v)), "share of the analysis set": 1.0,
                         "aircraft per patent": round(len(v) / len(pat), 2)}
    return out


def firm_leverage(v: pd.DataFrame, min_aircraft: int = 3) -> pd.DataFrame:
    """How much any one firm can move the class reading of this document.

    For each named firm: drop it from the analysis set and re-take the class shares; the answer is
    the largest share that moves and by how many percentage points. It is the direct test of "is
    this class share a real spread of firms or one firm's portfolio" — the author's question at
    1.1.6 and 1.2.3. Done on the whole set and again inside the two windows that carry most of the
    corpus, because a firm can be negligible overall and dominant in one window.
    """
    base_all = v["topType"].value_counts(normalize=True)
    sizes = firm_sizes(v)
    keep = sizes[sizes >= min_aircraft].index
    rows = []
    for f in keep:
        d = (v[~v["company_canonical"].eq(f)]["topType"].value_counts(normalize=True)
             .reindex(base_all.index).fillna(0) - base_all)
        moved = d.abs().idxmax()
        worst_w, worst_pp, worst_c = "", 0.0, ""
        for wn in WINDOW_NAMES[:-1]:
            sub = v[v["window"].eq(wn)]
            if len(sub) < 30 or not sub["company_canonical"].eq(f).any():
                continue
            b = sub["topType"].value_counts(normalize=True)
            dw = (sub[~sub["company_canonical"].eq(f)]["topType"].value_counts(normalize=True)
                  .reindex(b.index).fillna(0) - b)
            if float(dw.abs().max()) > worst_pp:
                worst_w, worst_pp, worst_c = wn, float(dw.abs().max()), dw.abs().idxmax()
        rows.append({"firm": f, "unique aircraft": int(sizes[f]),
                     "share of the analysis set": round(float(sizes[f] / len(v)), 3),
                     "class most moved": moved,
                     "shift if the firm is dropped (pp)": round(float(d[moved]) * 100, 2),
                     "largest shift inside one window (pp)": round(worst_pp * 100, 1),
                     "that window": worst_w, "that class": worst_c,
                     "modal class": (v[v["company_canonical"].eq(f)]["topType"].mode().iloc[0]
                                     if v[v["company_canonical"].eq(f)]["topType"].notna().any() else "")})
    out = pd.DataFrame(rows)
    # unsigned copy of the shift: the sort key, and the column a "how many firms move a share by at
    # least 1 pp" reading can be counted on. Not printed (it is absent from la_index.COLUMNS).
    out["shift magnitude (pp)"] = out["shift if the firm is dropped (pp)"].abs()
    return out.sort_values("shift magnitude (pp)", ascending=False).reset_index(drop=True)


def class_concentration(v: pd.DataFrame) -> pd.DataFrame:
    """Per class: how many named firms file in it, and how much of it the largest one and the
    largest three hold. The companion of :func:`firm_leverage` — a class whose top firm holds a
    small share cannot be one firm's portfolio."""
    tot = v["topType"].value_counts()
    rows = []
    for c, n in tot.items():
        named = v[v["topType"].eq(c) & v["named"]]["company_canonical"].value_counts()
        rows.append({"class": c, "aircraft": int(n), "named firms filing in it": int(len(named)),
                     "largest firm": (named.index[0] if len(named) else ""),
                     "its share of the class": round(float(named.iloc[0] / n), 2) if len(named) else 0.0,
                     "top 3 firms' share": round(float(named.head(3).sum() / n), 2) if len(named) else 0.0,
                     "share held by named firms": round(float(named.sum() / n), 2)})
    return pd.DataFrame(rows)


def cohort_mix(v: pd.DataFrame, printed: bool = True) -> pd.DataFrame:
    """The normalised form of the entry cohorts (author's ruling 2026-09-23: 1.2.2 must be
    normalised by the number of firms). Per window and class: the share of that window's ENTRANTS
    who enter with the class, beside the share of that window's AIRCRAFT in the same class.

    The two shares are what makes the section say something 1.1.2 does not: 1.1.2 counts aircraft,
    this counts firms, and the gap between them is whether the class shift is carried by new firms
    or by the firms already inside.
    """
    co = cohorts(v).set_index("window").reindex(WINDOW_NAMES).fillna(0)
    rows = []
    for wn in WINDOW_NAMES:
        n_ent = int(co.loc[wn, "firms entering"])
        air = v[v["window"].eq(wn)]["topType"].value_counts()
        n_air = int(air.sum())
        for c in [c for c in co.columns if c != "firms entering"]:
            e = int(co.loc[wn, c])
            if not e and not air.get(c, 0):
                continue
            s_e = e / n_ent if n_ent else np.nan
            s_a = float(air.get(c, 0)) / n_air if n_air else np.nan
            rows.append({"window": wn, "class": c, "firms entering": n_ent, "entering with this class": e,
                         "share of entrants": round(s_e, 3), "aircraft in the window": n_air,
                         "aircraft of this class": int(air.get(c, 0)), "share of aircraft": round(s_a, 3),
                         "entrants ahead of the field (pp)": round((s_e - s_a) * 100, 1)})
    out = pd.DataFrame(rows)
    out.attrs["all rows"] = len(out)
    if not printed:
        return out
    # the printed table keeps the rows that can carry a reading -- a class holding at least a tenth
    # of the entrants or a tenth of the aircraft of its window. The figure draws every class.
    keep = (out["share of entrants"] >= 0.10) | (out["share of aircraft"] >= 0.10)
    return out[keep].reset_index(drop=True)


def filers_by_window(v: pd.DataFrame) -> pd.DataFrame:
    """Named firms active per window: new (first window), continuing, last seen (no later
    filing; not judged in the partial window); plus the individual-inventor share."""
    w = v.dropna(subset=["window"])
    named = w[w["named"]]
    first = named.groupby("company_canonical")["window"].agg(lambda s: min(s, key=WINDOW_NAMES.index))
    last = named.groupby("company_canonical")["window"].agg(lambda s: max(s, key=WINDOW_NAMES.index))
    rows = []
    for i, name in enumerate(WINDOW_NAMES):
        sub = named[named["window"].eq(name)]
        firms = sub["company_canonical"].unique()
        new = sum(first[f] == name for f in firms)
        gone = sum(last[f] == name for f in firms) if i < len(WINDOW_NAMES) - 2 else np.nan
        allw = w[w["window"].eq(name)]
        rows.append({"window": name, "unique aircraft": int(len(allw)),
                     "named firms active": int(len(firms)), "new firms": int(new),
                     "continuing firms": int(len(firms) - new),
                     "firms last seen": (int(gone) if not np.isnan(gone) else ""),
                     "aircraft by named firms": int(len(sub)),
                     "share individual inventors": round(float(allw["filer"].eq("Individual inventor").mean()), 2),
                     # was "share unattributed" until 2026-09-23; that band is empty once the filer
                     # type is read off the raw assignee string, so the column that earns the space
                     # is the other non-company one
                     "share universities / institutes": round(float(allw["filer"].eq("University / institute").mean()), 2)})
    return pd.DataFrame(rows)


def firm_windows(v: pd.DataFrame, min_aircraft: int = FIRM_MIN) -> pd.DataFrame:
    """Firm × window: aircraft count and modal class, firms with ``min_aircraft`` or more."""
    sizes = firm_sizes(v)
    firms = sizes[sizes >= min_aircraft].index
    w = v[v["company_canonical"].isin(firms)].dropna(subset=["window"])
    rows = []
    for f in firms:
        sub = w[w["company_canonical"].eq(f)]
        first = min(sub["window"], key=WINDOW_NAMES.index)
        for name in WINDOW_NAMES:
            s = sub[sub["window"].eq(name)]
            modal = s["topType"].value_counts().index[0] if len(s) and s["topType"].notna().any() else None
            rows.append({"firm": f, "aircraft total": int(sizes[f]), "first window": first,
                         "window": name, "aircraft": int(len(s)), "modal class": modal,
                         "classes": int(s["topType"].nunique())})
    return pd.DataFrame(rows)


def firm_region(v: pd.DataFrame) -> pd.Series:
    """Modal region of each named firm's patents."""
    w = v[v["named"]]
    return w.groupby("company_canonical")["region3"].agg(lambda s: s.value_counts().index[0])


def proximity_by_region(ds: Dataset, v: pd.DataFrame, min_aircraft: int = FIRM_MIN,
                        draws: int = 10000, seed: int = 42) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """Jaffe proximity of the firm profiles (class), with the firms **grouped by region**.

    User ruling 2026-09-23: the firms are ordered region block by region block, so a block of
    high values inside one region is visible on the matrix itself and not only in the side
    strip. Inside a block the clustered order of :func:`a2.proximity_order` is kept, so design
    neighbours still sit together within their own region.

    The summary is the region × region table of mean proximity — every firm pair, split by the
    two regions it joins — with the number of pairs each mean rests on and a permutation test
    of the one question the table exists to answer: is a firm closer to the firms of its own
    region than to the firms of another? Returns (matrix in region-block order, summary)."""
    prof = a2.firm_profiles(ds, min_aircraft, "class")
    prox = a2.proximity_matrix(prof)
    clustered = a2.proximity_order(prox)
    reg = firm_region(v).reindex(clustered)
    blocks = REGIONS + sorted({str(r) for r in reg if r not in REGIONS})
    order = [f for b in blocks for f in clustered if reg[f] == b]
    m = prox.loc[order, order]
    reg = reg.reindex(order)
    pairs = []
    for i, a in enumerate(order):
        for b in order[i + 1:]:
            pairs.append({"a": a, "b": b, "proximity": float(prox.loc[a, b]),
                          "region a": reg[a], "region b": reg[b],
                          "pair": " / ".join(sorted([str(reg[a]), str(reg[b])])),
                          "same region": reg[a] == reg[b]})
    p = pd.DataFrame(pairs)
    summary = (p.groupby("pair")["proximity"]
               .agg(**{"pairs": "size", "mean": "mean", "median": "median",
                       "lowest": "min", "highest": "max"}).round(2))
    summary.index.name = "region pair"
    summary = summary.reset_index()
    summary["within a region?"] = np.where(
        summary["region pair"].str.split(" / ").map(lambda t: t[0] == t[-1]), "within", "across")
    # one permutation test, on the whole table: shuffle the region labels over the firms and
    # rebuild the same two means. It answers "is same-region proximity higher than
    # different-region proximity?" without assuming anything about the distribution.
    same = p.loc[p["same region"], "proximity"]
    diff = p.loc[~p["same region"], "proximity"]
    obs = float(same.mean() - diff.mean())
    rng = np.random.default_rng(seed)
    idx = {f: k for k, f in enumerate(order)}
    ia = np.array([idx[x] for x in p["a"]])
    ib = np.array([idx[x] for x in p["b"]])
    val = p["proximity"].to_numpy()
    labels = reg.to_numpy()
    hits = 0
    for _ in range(draws):
        perm = rng.permutation(labels)
        s = perm[ia] == perm[ib]
        if s.all() or not s.any():
            continue
        if val[s].mean() - val[~s].mean() >= obs:
            hits += 1
    summary.attrs.update({"same mean": round(float(same.mean()), 3), "same pairs": int(len(same)),
                          "different mean": round(float(diff.mean()), 3), "different pairs": int(len(diff)),
                          "gap": round(obs, 3), "p": round(hits / draws, 3), "draws": int(draws)})
    m.attrs["region"] = reg
    m.attrs["blocks"] = [b for b in blocks if (reg == b).any()]
    return m, summary


# ------------------------------------------------------- ARI ---------------
def _load_ari() -> Tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    cur = pd.read_csv(ARI_DIR / "ari_may2026.csv", keep_default_na=False)
    hist = pd.read_csv(ARI_DIR / "ari_history.csv")
    cmap = pd.read_csv(ARI_DIR / "ari_company_map.csv", keep_default_na=False)
    return cur, hist, cmap


def _oem_key(s: str) -> str:
    s = re.sub(r"\(.*?\)", "", str(s)).strip().lower()
    return re.sub(r"[^a-z0-9]+", " ", s).strip()


def ari_listed(v: pd.DataFrame) -> set:
    """The canonical companies of the corpus that the AAM Reality Index rates — in the May 2026
    release or in any earlier one. Membership, not score: it is the "the market rates this firm"
    flag that 1.2.1 compares the other named firms against."""
    _, _, cmap = _load_ari()
    return set(cmap.loc[cmap["company_canonical"].ne(""), "company_canonical"]) & set(firm_sizes(v).index)


def ari_firms(v: pd.DataFrame) -> pd.DataFrame:
    """Every AAM Reality Index OEM that files in the corpus: score (May 2026 or the last release
    that listed it), disclosed funding, unique aircraft, classes and re-filings."""
    cur, hist, cmap = _load_ari()
    cmap = cmap[cmap["company_canonical"].ne("")]
    key_to_canon = {_oem_key(r["oem"]): r["company_canonical"] for _, r in cmap.iterrows()}
    cur["key"] = cur["oem"].map(_oem_key)
    cur["company_canonical"] = cur["key"].map(key_to_canon)
    hist["key"] = hist["oem"].map(_oem_key)
    hist["company_canonical"] = hist["key"].map(key_to_canon)
    dates = [c for c in hist.columns if c not in ("oem", "key", "company_canonical")]
    sizes = firm_sizes(v)
    rows = []
    for canon in sorted(set(cmap["company_canonical"])):
        c = cur[cur["company_canonical"].eq(canon)]
        h = hist[hist["company_canonical"].eq(canon)]
        score = last = funding = vtype = None
        if len(c):
            score = float(c["ari"].iloc[0]); last = "May 2026"
            funding = c["funding_musd"].iloc[0]; vtype = c["vehicle_type"].iloc[0]
        elif len(h):
            s = h[dates].apply(pd.to_numeric, errors="coerce").iloc[0]
            valid = s.dropna()
            if len(valid):
                score, last = float(valid.iloc[-1]), valid.index[-1]
        sub = v[v["company_canonical"].eq(canon)]
        mix = sub["topType"].value_counts()
        rows.append({"company": canon, "ARI score": score, "release": last,
                     "funding $M": funding if funding not in (None, "") else "",
                     "ARI vehicle type": vtype or "",
                     "unique aircraft": int(sizes.get(canon, 0)),
                     "classes": int(mix.size),
                     "class mix": " · ".join(f"{metrics.ARCH_NAMES.get(k, k)} {n}" for k, n in mix.items()),
                     "median propulsive units": (float(sub["units"].median()) if "units" in sub and sub["units"].notna().any() else np.nan),
                     "first priority year": (int(sub["year"].min()) if sub["year"].notna().any() else ""),
                     "in the corpus": int(sizes.get(canon, 0)) > 0})
    out = pd.DataFrame(rows)
    return out[out["in the corpus"]].sort_values("ARI score", ascending=False).reset_index(drop=True)


def ari_history_corpus(v: pd.DataFrame) -> pd.DataFrame:
    """Score per release for the ARI OEMs that file in the corpus (long form)."""
    cur, hist, cmap = _load_ari()
    key_to_canon = {_oem_key(r["oem"]): r["company_canonical"] for _, r in cmap.iterrows() if r["company_canonical"]}
    hist["company"] = hist["oem"].map(_oem_key).map(key_to_canon)
    sizes = firm_sizes(v)
    hist = hist[hist["company"].isin(sizes.index)]
    dates = [c for c in hist.columns if c not in ("oem", "key", "company")]
    long = hist.melt(id_vars=["company", "oem"], value_vars=dates, var_name="release", value_name="score")
    long["score"] = pd.to_numeric(long["score"], errors="coerce")
    long["date"] = pd.to_datetime(long["release"], format="%B %Y")
    return long.dropna(subset=["score"]).sort_values(["company", "date"]).reset_index(drop=True)


#: What Spearman's rho is, printed under Table 1.2.7b. Kept here so the table, the figure and the
#: provenance line can never give three different accounts of the same statistic.
SPEARMAN_NOTE = (
    "Spearman's rho is Pearson's correlation computed on **ranks** instead of values. Each column is "
    "replaced by its order — 1st, 2nd, 3rd … — and the two orders are correlated: +1 means the firm "
    "with the highest index score also has the highest value of the other column and so on down, -1 "
    "means the two orders are exactly reversed, 0 means the orders are unrelated. It is the right "
    "statistic here for three reasons. The index score is itself an ordinal judgement on a 0-10 "
    "scale, not a measured quantity, so the distance between 7.8 and 8.0 has no meaning while the "
    "order does. The patent-side columns are small skewed counts where one firm (Bell with 60 "
    "aircraft, Joby with $5.2 bn) would dominate a Pearson correlation; on ranks it cannot. And n is "
    "at most 18 firms, so nothing stronger than a monotone-order statement is supportable. `p` is the "
    "chance of seeing a rho at least this far from zero if the two orders were unrelated; `q` is the "
    "same p after a Benjamini-Hochberg correction for the whole family of tests in the table, which "
    "is what keeps a table of this size from producing a 'finding' by chance alone")


def ari_correlation(firms: pd.DataFrame, v: pd.DataFrame,
                    ds: Optional[Dataset] = None) -> pd.DataFrame:
    """Spearman correlations between the index side and the patent side, over the index firms.

    The index side is the index's own four quantities — score, disclosed funding, stated first flight
    and stated entry into service. The patent side is every labelled or bibliographic firm measure
    this document can build. Every pair is tested, `p` is printed, and a Benjamini-Hochberg `q`
    is printed beside it: the table runs dozens of tests on at most 18 firms, so without the
    correction four or five rows would clear p < 0.05 by chance alone. Descriptive only.
    """
    from scipy.stats import spearmanr
    f = firms.copy()
    f["funding"] = pd.to_numeric(f["funding $M"].astype(str).str.replace(",", ""), errors="coerce")
    if ds is not None:
        rank = cohort_citation_rank(ds)
        av = ds.approved_variants.merge(ds.identity[["patent_id", "claim_count", "family_size"]],
                                        on="patent_id", how="left", suffixes=("", "_id")).drop_duplicates("patent_id")
        # the firm identity comes from the analysis frame, not from the stored canonical: since
        # 2026-09-23 an organisation the grouper's table does not hold still has a firm name
        av["company_canonical"] = av["patent_id"].map(patent_firm(v))
        by = av.groupby("company_canonical")
        f["patents"] = f["company"].map(by.size())
        f["patents per aircraft"] = f["patents"] / f["unique aircraft"].replace(0, np.nan)
        f["median claims"] = f["company"].map(by["claim_count"].apply(lambda s: pd.to_numeric(s, errors="coerce").median()))
        f["median family size"] = f["company"].map(by["family_size"].apply(lambda s: pd.to_numeric(s, errors="coerce").median()))
        f["median cohort citation rank"] = f["company"].map(by["patent_id"].apply(lambda s: rank.reindex(s).median()))
    w = v[v["named"]]
    grp = w.groupby("company_canonical")
    wing = pd.to_numeric(w["wCount"], errors="coerce").fillna(0).gt(0).groupby(w["company_canonical"]).mean()
    boom = pd.to_numeric(w["nBooms"], errors="coerce").fillna(0).gt(0).groupby(w["company_canonical"]).mean()
    f["share with a ducted unit"] = f["company"].map(grp["any_ducted"].mean())
    f["share with a tilting unit"] = f["company"].map(grp["any_tilting"].mean())
    f["share with a wing"] = f["company"].map(wing)
    f["share with booms"] = f["company"].map(boom)
    f["share Lift + Cruise"] = f["company"].map(grp["topType"].apply(lambda s: s.eq("SLC").mean()))
    f["share vectored-thrust classes"] = f["company"].map(
        grp["topType"].apply(lambda s: s.isin(["TR", "TW", "CVT", "TB", "PTC", "DS"]).mean()))
    f["share no longer in force"] = f["company"].map(grp["lapsed"].mean())
    f["first flight (index)"] = f["company"].map(
        ari_timeline(v).set_index("company")["first flight (ARI)"])
    f["entry into service (index)"] = f["company"].map(
        ari_timeline(v).set_index("company")["entry into service (ARI)"])
    xs = ["ARI score", "funding", "first flight (index)", "entry into service (index)"]
    ys = [c for c in ["unique aircraft", "classes", "patents", "patents per aircraft",
                      "median propulsive units", "share with a ducted unit", "share with a tilting unit",
                      "share with a wing", "share with booms", "share Lift + Cruise",
                      "share vectored-thrust classes", "first priority year", "median claims",
                      "median family size", "median cohort citation rank", "share no longer in force"]
          if c in f.columns]
    rows = []
    for x in xs:
        for y in ys:
            d = f[[x, y]].apply(pd.to_numeric, errors="coerce").dropna()
            if len(d) >= 6 and d[x].nunique() > 2 and d[y].nunique() > 2:
                rho, p = spearmanr(d[x], d[y])
                rows.append({"x": x, "y": y, "n firms": int(len(d)),
                             "Spearman rho": round(float(rho), 2), "p": float(p)})
    out = pd.DataFrame(rows).sort_values("p").reset_index(drop=True)
    if len(out):
        m = len(out)
        out["q (BH)"] = (out["p"] * m / (np.arange(m) + 1))[::-1].cummin()[::-1].round(3)
        out["holds?"] = np.where(out["q (BH)"] < 0.10, "yes",
                                 np.where(out["p"] < 0.05, "chance-level", "no"))
        out["p"] = out["p"].round(3)
        out.attrs["tests"] = m
        out.attrs["note"] = SPEARMAN_NOTE
    return out


#: The four labelled or bibliographic measures the index firms differ on and the ones they do not:
#: computed by :func:`ari_gap`, which is the answer to "which of my variables correlate with the index".
#: ``(printed name, column, kind, re-test on the US patents alone?)``. The last flag is False for the
#: applicant region only: the region is read off the applicant's country, so restricting the test to
#: US-published patents would be testing the variable against itself.
ARI_GAP_VARS = [("cohort citation rank", "cohort citation rank", "number", True),
                ("no longer in force", "lapsed", "share", True),
                ("propulsive units per aircraft", "units", "number", True),
                ("has booms", "_boomed", "share", True),
                ("has a ducted unit", "any_ducted", "share", True),
                ("has a tilting unit", "any_tilting", "share", True),
                ("has a wing", "_winged", "share", True),
                ("claims", "claim_count", "number", True),
                ("family size", "family_size", "number", True),
                ("priority year", "year", "number", True),
                ("architecture class (12)", "topType", "mix", True),
                ("architecture class (5 folded)", "class5", "mix", True),
                ("applicant region", "region3", "mix", False)]


def ari_gap(ds: Dataset, v: pd.DataFrame) -> pd.DataFrame:
    """The real correlation test: the aircraft of the index firms against every other aircraft.

    Eighteen firms is too few to correlate anything reliably (Table 1.2.7b), but those eighteen firms
    hold 150 of the {n} unique aircraft, and *that* comparison has power. For each labelled or
    bibliographic variable the table asks one question — do the aircraft of the firms the market calls
    real differ from the rest of the corpus? — and answers it with a distribution-free test: a
    Mann-Whitney U for a number, a Fisher exact test for a yes/no field, a chi-square for a category
    with more than two levels. `q` is the Benjamini-Hochberg correction over the whole table.

    The last two columns are the honest part. The index firms are 85 % US-published against 51 % for
    the rest of the corpus, so any difference could be an office effect rather than an index effect;
    the column ``holds within the US patents alone`` repeats every test on the US-published patents
    only. A row that holds in both columns is a finding about the firms; a row that holds only in the
    first is a finding about the patent office.
    """
    from scipy.stats import chi2_contingency, fisher_exact, mannwhitneyu
    firms = set(ari_firms(v)["company"])
    w = v.copy()
    w["in the index"] = w["company_canonical"].isin(firms)
    ident = ds.identity.drop_duplicates("patent_id").set_index("patent_id")
    w["cohort citation rank"] = cohort_citation_rank(ds).reindex(w["patent_id"]).to_numpy()
    w["pub_office"] = ident["pub_office"].reindex(w["patent_id"]).to_numpy()
    w["_winged"] = pd.to_numeric(w["wCount"], errors="coerce").fillna(0).gt(0)
    w["_boomed"] = pd.to_numeric(w["nBooms"], errors="coerce").fillna(0).gt(0)

    def one(sub: pd.DataFrame, col: str, kind: str):
        """(index value, rest value, p) for one variable on one slice, or None."""
        a = sub["in the index"]
        if kind == "number":
            x = pd.to_numeric(sub.loc[a, col], errors="coerce").dropna()
            y = pd.to_numeric(sub.loc[~a, col], errors="coerce").dropna()
            if len(x) < 5 or len(y) < 5:
                return None
            return float(x.median()), float(y.median()), float(mannwhitneyu(x, y).pvalue)
        if kind == "share":
            b = sub[col].map({True: True, False: False, 1: True, 0: False})
            ok = b.notna()
            b, aa = b[ok].astype(bool), a[ok]
            t = pd.crosstab(aa, b)
            if t.shape != (2, 2):
                return None
            return float(b[aa].mean()), float(b[~aa].mean()), float(fisher_exact(t).pvalue)
        t = pd.crosstab(a, sub[col])
        if t.shape[0] != 2 or t.shape[1] < 2 or (t.to_numpy() < 5).mean() > 0.4:
            return None
        sh = pd.crosstab(a, sub[col], normalize="index")
        lev = (sh.loc[True] - sh.loc[False]).abs().idxmax()      # the level the two sides differ most on
        return f"{lev} {sh.loc[True, lev]:.0%}", f"{lev} {sh.loc[False, lev]:.0%}", float(chi2_contingency(t)[1])

    us = w[w["pub_office"].eq("US")]
    rows = []
    for label, col, kind, strat in ARI_GAP_VARS:
        r = one(w, col, kind)
        if r is None:
            continue
        ru = one(us, col, kind) if strat else None

        def fmt(z):
            if isinstance(z, str):
                return z
            if not np.isfinite(z):
                return ""
            return f"{z:.0%}" if kind == "share" else f"{round(float(z), 2):g}"
        rows.append({"variable": label,
                     "test": {"number": "Mann-Whitney U", "share": "Fisher exact"}.get(kind, "chi-square"),
                     "index firms": fmt(r[0]), "rest of the corpus": fmt(r[1]), "p": r[2],
                     "p, US patents only": (ru[2] if ru else np.nan),
                     "_strat": strat})
    out = pd.DataFrame(rows).sort_values("p").reset_index(drop=True)
    m = len(out)
    out["q (BH)"] = (out["p"] * m / (np.arange(m) + 1))[::-1].cummin()[::-1]
    out["holds?"] = np.where(out["q (BH)"] >= 0.05, "no",
                             np.where(~out["_strat"], "yes, by selection",
                                      np.where(out["p, US patents only"].fillna(1) < 0.05,
                                               "yes", "office effect")))
    out = out.drop(columns=["_strat"])
    # a p of 3e-12 must not print as "0": below the printed resolution it says "<0.0001"
    show = lambda z: ("" if not np.isfinite(z) else ("<0.0001" if z < 0.0001 else f"{z:.4f}".rstrip("0").rstrip(".")))
    for c in ("p", "p, US patents only", "q (BH)"):
        out[c] = out[c].map(show)
    out.attrs["n index"] = int(w["in the index"].sum())
    out.attrs["n rest"] = int((~w["in the index"]).sum())
    out.attrs["n firms"] = len(firms)
    out.attrs["us index"] = round(float(w.loc[w["in the index"], "pub_office"].eq("US").mean()), 3)
    out.attrs["us rest"] = round(float(w.loc[~w["in the index"], "pub_office"].eq("US").mean()), 3)
    return out


