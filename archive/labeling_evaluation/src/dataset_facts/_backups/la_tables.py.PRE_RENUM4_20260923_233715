del _a, _b

COUPLING_MIN_N = 30     # a pair is measured on at least this many aircraft answering both fields
COUPLING_STRONG = 0.75  # a predicted pair "stronger than most" sits above this quantile of the rest


def cramers_v_bc(x: pd.Series, y: pd.Series) -> Tuple[float, int]:
    """Bias-corrected Cramér's V (Bergsma, 2013) on the rows where both fields carry a value:
    φ² is shrunk by (k−1)(r−1)/(n−1) and the table dimensions by the same order, so a pair of
    sparse fields does not score on its sparseness. Returns (V, n)."""
    from scipy.stats import chi2_contingency
    d = pd.DataFrame({"x": x.astype(object), "y": y.astype(object)}).dropna()
    d = d[~d["x"].astype(str).isin(["<NA>", "nan", ""]) & ~d["y"].astype(str).isin(["<NA>", "nan", ""])]
    n = len(d)
    if n < COUPLING_MIN_N:
        return np.nan, n
    ct = pd.crosstab(d["x"].astype(str), d["y"].astype(str))
    r, k = ct.shape
    if r < 2 or k < 2:
        return np.nan, n
    chi2 = chi2_contingency(ct.values, correction=False)[0]
    phi2 = max(0.0, chi2 / n - (k - 1) * (r - 1) / (n - 1))
    kc, rc = k - (k - 1) ** 2 / (n - 1), r - (r - 1) ** 2 / (n - 1)
    den = min(kc - 1, rc - 1)
    return (float(np.sqrt(phi2 / den)) if den > 0 else np.nan), n


def _coupling_fields(ds: Dataset, v: pd.DataFrame) -> pd.DataFrame:
    """The field frame the coupling test runs on: the Gower shortlist of the Preliminary Analysis
    (unpooled, so the boom and wing-card fields the predicted pairs need are present) plus the
    retraction and propulsor-type traces; every count banded so V is read on categories."""
    f = a3.gower_frame(ds)
    fields = a3.gower_fields(ds, pooled=False)
    t = trace_frame(ds, v)[["aircraft_id", "retract", "n_types"]]
    F = f[["aircraft_id"] + fields].merge(t, on="aircraft_id", how="left")
    F["propulsor_units"] = unit_band(pd.DataFrame({"units": F["propulsor_units"], "rotorBin": ""}))
    for c in ("wing1_count", "boom_count", "fuselage_count", "emp_count"):
        s = pd.to_numeric(F[c], errors="coerce")
        F[c] = pd.cut(s, [-1, 0, 2, 4, 8, 10 ** 6], labels=["0", "1-2", "3-4", "5-8", "9+"]).astype(object).where(s.notna())
    s = pd.to_numeric(F["n_types"], errors="coerce")
    F["n_types"] = pd.cut(s, [0, 1, 2, 3, 10 ** 6], labels=["1", "2", "3", "4+"]).astype(object).where(s.notna())
    F["wCount"] = pd.to_numeric(F["wCount"], errors="coerce").astype(object)
    F.attrs["fields"] = fields + ["retract", "n_types"]
    return F


def trace_couplings(ds: Dataset, v: pd.DataFrame) -> pd.DataFrame:
    """Every pair of the coupling fields with its bias-corrected Cramér's V, the aircraft it is
    measured on, whether the pair is definitional, and — for the predicted pairs — the driver,
    the printed name and the pair's rank among the non-definitional pairs. ``attrs`` carries the
    distribution (median, quartiles, the 90th percentile) the predicted pairs are read against."""
    import itertools
    F = _coupling_fields(ds, v)
    fields = F.attrs["fields"]
    rows = []
    pred = {frozenset((a, b)): (drv, name) for drv, a, b, name in PREDICTED_COUPLINGS}
    for a, b in itertools.combinations(fields, 2):
        V, n = cramers_v_bc(F[a], F[b])
        key = frozenset((a, b))
        rows.append({"field a": a, "field b": b, "V": (round(V, 3) if pd.notna(V) else np.nan), "aircraft": n,
                     "definitional": key in _DEF_PAIRS,
                     "driver": pred.get(key, ("", ""))[0], "predicted pair": pred.get(key, ("", ""))[1]})
    out = pd.DataFrame(rows)
    rest = out[out["V"].notna() & ~out["definitional"]]["V"]
    out["percentile"] = np.nan
    ok = out["V"].notna()
    out.loc[ok, "percentile"] = [round(float((rest < x).mean()), 2) for x in out.loc[ok, "V"]]
    q = rest.quantile([0.5, 0.75, 0.9]).to_dict()
    out.attrs.update({"pairs": int(len(out)), "measured": int(out["V"].notna().sum()),
                      "definitional": int(out["definitional"].sum()), "rest": int(len(rest)),
                      "median": round(float(q[0.5]), 3), "q75": round(float(q[0.75]), 3), "q90": round(float(q[0.9]), 3),
                      "fields": fields})
    return out


def predicted_couplings(ds: Dataset, v: pd.DataFrame, pairs: Optional[pd.DataFrame] = None) -> pd.DataFrame:
    """The printed table: one row per predicted pair with V, n, its percentile among the
    non-definitional pairs and the reading, closed by the three strongest non-definitional pairs
    of the whole matrix so the reader sees what the record does couple."""
    P = pairs if pairs is not None else trace_couplings(ds, v)
    q75, q90, med = P.attrs["q75"], P.attrs["q90"], P.attrs["median"]
    rows = []
    for drv, a, b, name in PREDICTED_COUPLINGS:
        r = P[((P["field a"] == a) & (P["field b"] == b)) | ((P["field a"] == b) & (P["field b"] == a))]
        if not len(r):
            continue
        r = r.iloc[0]
        V, pct = r["V"], r["percentile"]
        if pd.isna(V):
            read = "not measurable (too few aircraft answer both)"
        elif V >= q90:
            read = "among the strongest tenth of all pairs"
        elif V >= q75:
            read = "above the upper quartile of all pairs"
        elif V >= med:
            read = "no stronger than a typical pair"
        else:
            read = "weaker than a typical pair"
        rows.append({"driver": _driver_name(drv), "predicted pair": name, "fields": f"{a} × {b}",
                     "V": V, "aircraft": int(r["aircraft"]),
                     "percentile among non-definitional pairs": pct, "reading": read})
    top = P[~P["definitional"] & P["V"].notna()].sort_values("V", ascending=False).head(3)
    for _, r in top.iterrows():
        rows.append({"driver": "(none predicted)", "predicted pair": "strongest pair in the matrix",
                     "fields": f"{r['field a']} × {r['field b']}", "V": r["V"], "aircraft": int(r["aircraft"]),
                     "percentile among non-definitional pairs": r["percentile"],
                     "reading": "what the record does couple, for scale"})
    out = pd.DataFrame(rows)
    out.attrs.update(P.attrs)
    return out


def driver_questions(ds: Dataset, v: pd.DataFrame, trends: Optional[pd.DataFrame] = None) -> pd.DataFrame:
    """The three questions the author put to the traces, each answered in one generated sentence
    out of :func:`trace_trends`, so every number in the answer is the table's own."""
    tt = trends if trends is not None else trace_trends(ds, v)

    def row(trace: str, code: str) -> pd.Series:
        return tt[tt["trace"].eq(trace) & tt["code"].eq(code)].iloc[0]

    def cell(trace: str, code: str, kind: str) -> str:
        r = row(trace, code)
        head = f"{code} {_span(r, kind)}"
        return head + (f" ({r['movement']}, ρ {r['rho']:+.2f}, {_fmt_p(r['p'])})" if pd.notna(r["rho"]) else f" ({r['movement']})")

    u = {c: row("propulsive units", c)["movement"] for c in ("SLC", "TR", "CVT", "TW", "MR")}
    rising = [c for c, m in u.items() if m == "rises"]
    q1 = (f"Neither MR-specific nor general: the median count rises in {', '.join(rising) or 'no class'} "
          f"and not in {', '.join(c for c in u if c not in rising)} — " + "; ".join(cell("propulsive units", c, "median") for c in u)
          + f"; pooled {cell('propulsive units', 'ALL5', 'median')}. ")
    slc, mr = row("propulsive units", "SLC"), row("propulsive units", "MR")
    if rising and slc["movement"] == "flat":
        q1 += (f"The rise is inside the classes that started low ({', '.join(rising)}); Lift + Cruise started at a median of "
               f"{slc['first value']:g} and does not move. ")
    if mr["movement"] == "flat" and pd.notna(mr["rho"]) and mr["rho"] > 0 and mr["p"] < 0.1:
        q1 += f"The Multirotor rise (ρ {mr['rho']:+.2f}, {_fmt_p(mr['p'])}) does not reach the 0.05 line on {int(mr['aircraft'])} aircraft."
    r = row("a propulsor retracts or folds its blades", "SLC")
    q2 = (f"No. Inside Lift + Cruise the share with a retracting or blade-folding unit is "
          f"{cell('a propulsor retracts or folds its blades', 'SLC', 'share')}: it is present from 2012-15 on and does not "
          f"spread; pooled {cell('a propulsor retracts or folds its blades', 'ALL5', 'share')}. The one-driver trace of drag "
          f"reduction is in the record at about one aircraft in ten and stays there.")
    j = {c: row("tilting joint groups", c) for c in ("TR", "CVT", "TW")}
    q3 = ("Inside the tilting classes the joint count rises — " + "; ".join(cell("tilting joint groups", c, "median") for c in j)
          + f" — so where a class moved it moved with regime transition and against the two cost drivers. Pooled over the five "
          f"classes it is {cell('tilting joint groups', 'ALL5', 'median')}: the sector as a whole adds no joints, because the "
          f"class growing fastest (Lift + Cruise, 1.1.2) has none. The opposed pair therefore splits by level — transition wins inside a "
          f"class, cost wins in the class mix — and the record cannot say which of the two the firms weighed.")
    return pd.DataFrame([
        {"question": "Is the rise in propulsive units MR-specific or general?", "answer": q1},
        {"question": "Does retraction of lift units rise inside Lift + Cruise over time?", "answer": q2},
        {"question": "Do tilting joints fall (cost) or rise (regime transition)?", "answer": q3},
    ])


