def transitions(v: pd.DataFrame) -> pd.DataFrame:
    """Within-firm successions: each named firm's aircraft in priority order, every consecutive pair
    (earlier class → later class). Rows: from, to, count."""
    w = v[v["named"] & v["topType"].notna()].dropna(subset=["year"]).sort_values(["company_canonical", "year", "aircraft_id"])
    pairs = []
    for f, sub in w.groupby("company_canonical"):
        t = sub["topType"].tolist()
        for a, b in zip(t[:-1], t[1:]):
            pairs.append({"firm": f, "from": a, "to": b})
    p = pd.DataFrame(pairs)
    out = p.groupby(["from", "to"]).size().reset_index(name="pairs")
    out["same class"] = out["from"].eq(out["to"])
    out.attrs["firms"] = int(p["firm"].nunique())
    out.attrs["pairs"] = int(len(p))
    out.attrs["same share"] = round(float(p["from"].eq(p["to"]).mean()), 2)
    return out


CITE_AGE_NOTE = ("forward citations accumulate with age: in this corpus raw counts fall with the priority "
                 "year at Spearman rho -0.53 over the 1 639 acquired patents, so a 2012 patent is ahead of "
                 "a 2022 one for having existed longer. The cohort rank removes that: rho falls to -0.02 "
                 "(p = 0.45)")


def cohort_citation_rank(ds: Dataset) -> pd.Series:
    """Age-normalised forward citations: each patent's percentile rank **inside its own priority
    year**, over every acquired patent of the corpus. Indexed by ``patent_id``.

    Raw forward citations reward age — a patent published in 2012 has had fourteen years to be
    cited and one published in 2022 four — so a firm or a class that files early scores higher for
    nothing but being early. Ranking each patent against the patents of its own priority year takes
    the age out: 0.50 means "cited like the median patent of its year", 0.90 means "in the top tenth
    of its year". It is a rank, so one very heavily cited patent cannot carry a whole class, and no
    citation window has to be chosen. The reference population is fixed (all acquired patents), so
    the rank of a patent never changes with the subset it is printed in.
    """
    p = ds.identity[["patent_id", "priority_year", "forward_citations"]].drop_duplicates("patent_id").copy()
    p["forward_citations"] = pd.to_numeric(p["forward_citations"], errors="coerce")
    p["priority_year"] = pd.to_numeric(p["priority_year"], errors="coerce")
    rank = p.groupby("priority_year")["forward_citations"].rank(pct=True)
    return pd.Series(rank.to_numpy(), index=p["patent_id"].to_numpy(), name="cohort citation rank")


def ip_strategy(ds: Dataset, v: pd.DataFrame, min_aircraft: int = FIRM_MIN) -> pd.DataFrame:
    """Per firm with ``min_aircraft`` or more: unique aircraft, representative patents (primary + O1/O2),
    patents per aircraft, median family size, median claims, mean forward citations, in-corpus
    self-citation share.

    Two citation columns are printed side by side on purpose (user review 2026-09-23): the raw mean,
    which is what the bubbles of Figure 1.2.5a are sized by, and the age-normalised median cohort rank
    of :func:`cohort_citation_rank`. Where the two disagree the firm is old, not influential. The
    claims column is a median and carries the publication office beside it, because claim counts are an
    office convention before they are a strategy — US patents in this corpus have a median of 20 claims
    and Chinese ones 10."""
    av = ds.approved_variants.merge(ds.identity[["patent_id", "family_size", "claim_count",
                                                 "forward_citations", "forward_citations_in_corpus",
                                                 "self_citations_in_corpus"]], on="patent_id", how="left",
                                    suffixes=("", "_id"))
    # firm identity from the analysis frame, not from the stored canonical (see :func:`patent_firm`)
    av["company_canonical"] = av["patent_id"].map(patent_firm(v))
    rank = cohort_citation_rank(ds)
    office = ds.identity.drop_duplicates("patent_id").set_index("patent_id")["pub_office"]
    sizes = firm_sizes(v)
    rows = []
    for f, n_air in sizes[sizes >= min_aircraft].items():
        sub = av[av["company_canonical"].eq(f)].drop_duplicates("patent_id")
        fwd_corpus = pd.to_numeric(sub["forward_citations_in_corpus"], errors="coerce").sum()
        self_c = pd.to_numeric(sub["self_citations_in_corpus"], errors="coerce").sum()
        rows.append({"firm": f, "unique aircraft": int(n_air), "patents": int(len(sub)),
                     "patents per aircraft": round(len(sub) / n_air, 2),
                     "median family size": float(pd.to_numeric(sub["family_size"], errors="coerce").median()),
                     "median claims": float(pd.to_numeric(sub["claim_count"], errors="coerce").median()),
                     "mean forward citations": round(float(pd.to_numeric(sub["forward_citations"], errors="coerce").mean()), 1),
                     "median cohort citation rank": round(float(rank.reindex(sub["patent_id"]).median()), 2),
                     "in-corpus forward citations": int(fwd_corpus),
                     "self-citation share (in corpus)": (round(float(self_c / fwd_corpus), 2) if fwd_corpus else np.nan),
                     "main office": (office.reindex(sub["patent_id"]).mode().iloc[0]
                                     if office.reindex(sub["patent_id"]).notna().any() else ""),
                     "region": v[v["company_canonical"].eq(f)]["region3"].mode().iloc[0]})
    out = pd.DataFrame(rows).sort_values("unique aircraft", ascending=False).reset_index(drop=True)
    out.attrs["age note"] = CITE_AGE_NOTE
    return out


def ip_by_class(v: pd.DataFrame, ds: Optional[Dataset] = None) -> pd.DataFrame:
    """Per class: median claims, citations read three ways, median family size (primary patents).

    Why each statistic is the one it is (user review 2026-09-23).

    *Claims* is a **median** because claim counts are bounded below by 1, capped in practice by the
    office's fee schedule and heavily tied at round numbers (20 in the United States): a mean would
    be dragged by a handful of very long applications and would not be the number a reader could
    check on a typical patent of the class. The column ``US share`` is printed beside it because
    claim counts are an office convention first — the corpus median is 20 claims at the USPTO
    and 10 at the CNIPA, in every single class — so a class's median claims mostly says how
    American that class's patents are.

    *Forward citations* are printed as a **mean and a median** because their distribution is very
    skewed: most patents are cited a few times and a few are cited a hundred times. The mean is the
    total attention the class has drawn (and is what the bubbles of Figure 1.2.5a are sized by); the
    median is what a typical patent of that class draws. Where the two are far apart, the class rests
    on one or two patents. Both are raw, so both reward age. The third column, ``median cohort
    citation rank``, is the age-normalised reading — each patent ranked against the patents of its
    own priority year — and it is the one to compare classes on.

    *Family size* and *priority year* are **medians**: family size is a small skewed count, and the
    median priority year is the age of the class, printed so the raw citation columns can be read
    against it.
    """
    w = v.dropna(subset=["topType"]).drop_duplicates("patent_id")
    g = w.groupby("topType").agg(patents=("patent_id", "size"),
                                 **{"median claims": ("claim_count", lambda s: pd.to_numeric(s, errors="coerce").median()),
                                    "mean forward citations": ("forward_citations", lambda s: pd.to_numeric(s, errors="coerce").mean()),
                                    "median forward citations": ("forward_citations", lambda s: pd.to_numeric(s, errors="coerce").median()),
                                    "median family size": ("family_size", lambda s: pd.to_numeric(s, errors="coerce").median()),
                                    "median priority year": ("year", "median")})
    if ds is not None:
        rank = cohort_citation_rank(ds)
        g["median cohort citation rank"] = w.groupby("topType")["patent_id"].apply(
            lambda s: rank.reindex(s).median())
        office = ds.identity.drop_duplicates("patent_id").set_index("patent_id")["pub_office"]
        g["US share"] = w.groupby("topType")["patent_id"].apply(lambda s: office.reindex(s).eq("US").mean())
        g = g[["patents", "median claims", "US share", "mean forward citations", "median forward citations",
               "median cohort citation rank", "median family size", "median priority year"]]
    g = g.sort_values("patents", ascending=False).round(2)
    g.index = [metrics.ARCH_NAMES.get(c, c) for c in g.index]
    g.index.name = "class"
    out = g.reset_index()
    out.attrs["age note"] = CITE_AGE_NOTE
    return out


def cohorts(v: pd.DataFrame) -> pd.DataFrame:
    """Named firms by the window of their first filing and the class they entered with."""
    w = v[v["named"]].dropna(subset=["window", "year"]).sort_values("year")
    first = w.groupby("company_canonical").first()
    tab = pd.crosstab(first["window"], first["topType"]).reindex(index=WINDOW_NAMES, fill_value=0)
    tab.insert(0, "firms entering", tab.sum(axis=1))
    return tab.reset_index()


#: Where the two market dates come from, printed under Figure 1.2.7c and Tables 1.2.7d/e.
ARI_DATE_SRC = (
    "first flight and entry into service are the index's own `first_flight` and `eis` fields, stored in "
    "`assets/external/aam_reality_index/ari_may2026.csv` — the May 2026 release of the AAM Reality "
    "Index, scraped from the Infogram embed of aamrealityindex.com on 2026-09-22 and kept verbatim. "
    "They are not a flight record and no aviation register was consulted: a first flight is what the "
    "index reports the firm has flown, an entry into service is what the index reports the firm plans, "
    "so every date from about 2026 on is a plan and not an event. Where the index lists several "
    "vehicles for one firm the earliest year printed in the cell is taken, and a dash is read as "
    "'not stated'. `ari_history.csv` beside it holds only the score per release — no dates")


def _first_year(text) -> Optional[int]:
    """Earliest four-digit year printed in an index cell, or None.

    The index prints one cell per OEM and lists every vehicle in it ("2021 / 2026 / 2023"), so the
    earliest year is taken: the firm's first flight is the first flight of whichever of its vehicles
    flew first. A cell holding only "-" gives None.
    """
    yrs = [int(m.group(0)) for m in re.finditer(r"(19|20)\d{2}", str(text))]
    return min(yrs) if yrs else None


def ari_timeline(v: pd.DataFrame) -> pd.DataFrame:
    """For the index firms in the corpus: first patent, peak filing year, first flight and entry into
    service as the index states them, and the two development gaps between the clocks.

    The gaps are the answer to "who develops fastest" (user review 2026-09-23). ``years to first
    flight`` is the index's first-flight year minus the firm's earliest priority year **in this
    corpus**, and ``years to entry into service`` the same against the stated entry into service. Both
    are left-truncated: the corpus starts at the firm's first *labelled* eVTOL patent, not at its first
    patent ever, so a firm that flew before it appears here prints a negative gap and the number is a
    floor, never a measured development time."""
    cur, hist, cmap = _load_ari()
    key_to_canon = {_oem_key(r["oem"]): r["company_canonical"] for _, r in cmap.iterrows() if r["company_canonical"]}
    cur["company"] = cur["oem"].map(_oem_key).map(key_to_canon)
    rows = []
    for _, r in cur.dropna(subset=["company"]).iterrows():
        sub = v[v["company_canonical"].eq(r["company"])].dropna(subset=["year"])
        if not len(sub):
            continue
        yrs = sub["year"].astype(int)
        ff, eis = _first_year(r["first_flight"]), _first_year(r["eis"])
        rows.append({"company": r["company"], "ARI score": float(r["ari"]), "first patent": int(yrs.min()),
                     "peak filing year": int(yrs.value_counts().sort_index().idxmax()), "last patent": int(yrs.max()),
                     "unique aircraft": int(len(sub)), "first flight (ARI)": ff,
                     "entry into service (ARI)": eis,
                     "years to first flight": (ff - int(yrs.min())) if ff else None,
                     "years to entry into service": (eis - int(yrs.min())) if eis else None,
                     "regulator (ARI)": r["cert_regulator"], "country (ARI)": r["country"],
                     "region": sub["region3"].mode().iloc[0],
                     "ARI vehicle type": r["vehicle_type"]})
    out = pd.DataFrame(rows).sort_values("first patent").reset_index(drop=True)
    out.attrs["dates"] = ARI_DATE_SRC
    return out


def ari_clock_region(v: pd.DataFrame) -> pd.DataFrame:
    """Which regions and certifying authorities move from patent to flight fastest.

    One row per certifying authority the index names (which is also, in practice, one row per
    jurisdiction), plus one row per applicant region of the patents. The columns are the medians of
    :func:`ari_timeline`: the year of the first flight itself, the years from the firm's earliest
    corpus patent to that flight, and the years from it to the stated entry into service. Small n:
    the firm count is printed on every row and no row rests on more than five firms, so the table
    ranks jurisdictions, it does not measure them."""
    tl = ari_timeline(v)
    tl = tl[tl["first flight (ARI)"].notna()]
    out = []
    for label, col in (("certifying authority", "regulator (ARI)"), ("applicant region of the patents", "region")):
        g = tl.groupby(tl[col].replace("", "not stated"))
        t = g.agg(**{"firms": ("company", "size"),
                     "median first flight": ("first flight (ARI)", "median"),
                     "median years, first patent to first flight": ("years to first flight", "median"),
                     "median years, first patent to entry into service": ("years to entry into service", "median"),
                     "firms listed": ("company", lambda s: ", ".join(sorted(s)))})
        t.index.name = "group"
        t = t.reset_index()
        t.insert(0, "grouped by", label)
        out.append(t.sort_values("median years, first patent to first flight"))
    res = pd.concat(out, ignore_index=True)
    for c in ("median first flight", "median years, first patent to first flight",
              "median years, first patent to entry into service"):
        res[c] = pd.to_numeric(res[c], errors="coerce").round(1)
    res.attrs["dates"] = ARI_DATE_SRC
    res.attrs["firms"] = int(len(tl))
    return res


# ------------------------------------------------------- 1.3 new: specialisation index
def specialisation(v: pd.DataFrame, min_aircraft: int = 5) -> Tuple[pd.DataFrame, pd.DataFrame]:
    """Location quotient of each A0c archetype per region: its share in the region divided by its
    share overall. 1 = as everywhere, 2 = twice the overall share. Returns (LQ, counts)."""
    w = v.dropna(subset=["archetype"])
    w = w[w["region3"].isin(REGIONS)]
    keep = w["archetype"].value_counts()
    keep = keep[keep >= min_aircraft].index
    w = w[w["archetype"].isin(keep)]
    counts = pd.crosstab(w["archetype"], w["region3"]).reindex(columns=REGIONS, fill_value=0)
    counts = counts.loc[counts.sum(axis=1).sort_values(ascending=False).index]
    share_region = counts.div(counts.sum(axis=0), axis=1)
    share_all = counts.sum(axis=1) / counts.values.sum()
    lq = share_region.div(share_all, axis=0)
    return lq.round(2), counts


