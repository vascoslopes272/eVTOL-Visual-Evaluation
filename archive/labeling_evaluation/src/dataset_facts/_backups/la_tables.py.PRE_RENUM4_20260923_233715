# ------------------------------------------------------- Appendix C ---------
def open_questions() -> pd.DataFrame:
    """Appendix C: the questions the corpus was asked and could not answer — one row per QUESTION.

    Built from ``la_index.OPEN_QUESTIONS`` (the questions), ``la_index.UNLABELLED_DRIVERS`` (the
    slot the design-drivers section fills) and ``la_index.GRADE`` (the reasons); nothing is typed
    here and no dataset is read:

    * ``what tried to answer it`` cites each item by the number it carries in the running order,
      resolved through ``la_index.item_numbers()`` at build time; an item built but placed in no
      node is named as such rather than given a number.
    * ``why the patent record cannot`` opens with the grade reason printed under every weak item
      the row cites — the same string out of the same register, so the appendix cannot say one
      thing and the item another — and then adds the entry's own ``cannot`` text. A ``[[name]]``
      in any field is replaced by that item's live number.
    * after the entries of each sector question comes one generated closing row naming every item
      GRADE marks weak that no entry cites, with its reason; so every weak item is accounted for
      exactly once, as the attempt behind a question or as a restatement of an item that stays.

    Five columns stay out of print and in the CSV: ``kind`` (question / closing), ``key`` (the
    entry's internal name) and ``weak items`` with its split ``weak items placed`` / ``weak items
    unplaced`` (the weak items the row accounts for; their sums are the takeaway's counts).
    ``la_index.COLUMNS`` selects the printed five.
    """
    from . import la_index as L            # one-way: la_index never imports this module

    numbers = L.item_numbers()
    weak = {k for k, v in L.GRADE.items() if str(v).startswith("weak")}

    def ref(name: str, mark: bool = False) -> str:
        """The live number, or the internal name of an item built but placed in no node — marked
        as such only where the item is first cited (the second column), not in every mention."""
        if name in numbers:
            return numbers[name]
        return f"`{name}` (built, not placed)" if mark else f"`{name}`"

    def reason(name: str) -> Optional[str]:
        g = str(L.GRADE.get(name, ""))
        if not g.startswith("weak"):
            return None
        m = re.search(r"\((.*)\)\s*$", g)
        return m.group(1) if m else g

    def fill(txt: Optional[str]) -> str:
        return re.sub(r"\[\[([^\]]+)\]\]", lambda m: ref(m.group(1)), txt or "")

    def group_of(name: str) -> str:
        # the per-item register still carries the OLD question id (Q1-Q8); QFOLD translates it to
        # the four chapters of 2026-09-23 so this appendix groups exactly as the document reads
        q = L.QFOLD.get(str(L.QUESTION.get(name, "none")).split(" ")[0], "none")
        return q if q in L.QUESTIONS else "none"

    entries = [(k, dict(e)) for k, e in L.OPEN_QUESTIONS.items()]
    for k, e in L.UNLABELLED_DRIVERS.items():
        e = dict(e)
        e.setdefault("q", "Q4")
        e.setdefault("sub", "design drivers")
        entries.append((k, e))
    for _, e in entries:                     # every entry still names one of the eight; fold it
        e["q"] = L.QFOLD.get(e.get("q", "Q4"), "2")

    order = list(L.QUESTIONS) + ["none"]
    cited: set = set()
    rows: List[Dict] = []
    for q in order:
        group = [(k, e) for k, e in entries if e["q"] == q]
        group.sort(key=lambda kv: 1 if kv[1].get("sub") else 0)      # stable: plain rows, then drivers
        for k, e in group:
            items = list(e.get("items", []))
            quoted: Dict[str, List[str]] = {}
            for i in items:
                r = reason(i)
                if r:
                    quoted.setdefault(r, []).append(ref(i))
            head = "; ".join(f"{r} ({', '.join(refs)})" for r, refs in quoted.items())
            tail = fill(e.get("cannot"))
            why = f"{head}. {tail}" if head and tail else (head or tail)
            tried = " · ".join(ref(i, mark=True) for i in items)
            if e.get("tried"):
                tried = f"{tried} · {fill(e['tried'])}" if tried else fill(e["tried"])
            fresh = [i for i in items if i in weak and i not in cited]
            cited.update(items)
            rows.append({"kind": "question", "key": k,
                         "sector question": f"{q} · {e['sub']}" if e.get("sub") else q,
                         "the question asked": fill(e.get("asked")),
                         "what tried to answer it": tried,
                         "why the patent record cannot": why,
                         "what would answer it": fill(e.get("would")),
                         "weak items": len(fresh),
                         "weak items placed": sum(1 for i in fresh if i in numbers),
                         "weak items unplaced": sum(1 for i in fresh if i not in numbers)})
        rest = [i for i in L.GRADE if i in weak and i not in cited and group_of(i) == q]
        if rest:
            cited.update(rest)
            if q == "none":
                asked = "Items graded weak that answer no sector question"
            elif group:
                asked = f"Items graded weak under {q} that raise no question of their own"
            else:
                asked = f"No open question under {q}: the items graded weak under it raise none of their own"
            rows.append({"kind": "closing", "key": f"closing_{q}",
                         "sector question": q,
                         "the question asked": asked,
                         "what tried to answer it": " · ".join(ref(i, mark=True) for i in rest),
                         "why the patent record cannot": " · ".join(f"{ref(i)}: {reason(i)}" for i in rest),
                         "what would answer it": "None: each restates an item that stays, is a check that "
                                                 "passed, or describes the drawings rather than the sector; "
                                                 "the reason names which",
                         "weak items": len(rest),
                         "weak items placed": sum(1 for i in rest if i in numbers),
                         "weak items unplaced": sum(1 for i in rest if i not in numbers)})
    return pd.DataFrame(rows, columns=["kind", "key", "sector question", "the question asked",
                                       "what tried to answer it", "why the patent record cannot",
                                       "what would answer it", "weak items", "weak items placed",
                                       "weak items unplaced"])


# ------------------------------------------------------- everything ---------
def build_all(ds: Dataset) -> Dict[str, pd.DataFrame]:
    v = base(ds)
    tables: Dict[str, pd.DataFrame] = {}
    tables["la_firm_weighted_shares"] = firm_weighted_shares(v)
    _, tables["la_lead_lag_region"] = lead_lag(v, "region3")
    _, tables["la_lead_lag_class"] = lead_lag(v, "topType", top=7)
    _med, _n = class_region_timing(v)
    _t = _med.map(lambda x: "–" if pd.isna(x) else (f"{x:.0f}" if float(x).is_integer() else f"{x:.1f}"))
    for _c in _med.columns:
        _t[f"{_c} (n)"] = _n[_c]
    tables["la_class_region_timing"] = _t[[c for pair in zip(_med.columns, [f"{c} (n)" for c in _med.columns])
                                           for c in pair]].reset_index()
    tables["la_class_cycles"] = class_cycles(v)
    tables["la_hill_by_window"] = hill_by_window(v)
    tables["la_zones"] = zones(v)
    tables["la_class_filer_weight"] = class_filer_weight(v)
    # written to tables/ and read by Figure 1.1.6b; not placed in a node of its own
    tables["la_class_window_filer_weight"] = class_window_filer_weight(v)
    tables["la_abandonment_by_class"] = abandonment_by_class(v)
    shares, n = country_class(v)
    cc = shares.round(2).copy()
    cc.insert(0, "aircraft", n)
    cc.columns = [metrics.ARCH_NAMES.get(c, c) if c != "aircraft" else c for c in cc.columns]
    tables["la_country_class"] = cc.reset_index().rename(columns={"assignee_country": "country"})
    # parked 2026-09-23 (author's ruling on 1.2.1: the curve now carries the counts, so the tier
    # table is not printed). Still built, so the numbers behind the curve stay checkable in
    # tables/la_firm_tiers.csv; put the name back in node 1.2.1 of la_index.NODES to print it.
    tables["la_firm_tiers"] = firm_tiers(v)
    tables["la_coverage_segments"] = coverage_segments(v)
    tables["la_market_vs_patents"] = market_vs_patents(v)
    tables["la_filer_mix"] = filer_mix(v)
    tables["la_firm_leverage"] = firm_leverage(v)
    tables["la_class_concentration"] = class_concentration(v)
    tables["la_cohort_mix"] = cohort_mix(v)
    tables["la_filers_by_window"] = filers_by_window(v)
    tables["la_firm_windows"] = firm_windows(v)
    _, tables["la_proximity_region"] = proximity_by_region(ds, v)
    firms = ari_firms(v)
    tables["la_ari_firms"] = firms
    tables["la_ari_correlation"] = ari_correlation(firms, v, ds)
    tables["la_ari_gap"] = ari_gap(ds, v)
    tables["la_class_fold"] = class_fold_table(v)
    tables["la_name_arch_check"] = name_arch_check(v)
    linked = linked_aircraft(v)
    tables["la_linked_aircraft"] = linked
    # written to tables/ and read by Figure 2.5c; not placed in a node of its own
    tables["la_linked_representativeness"] = linked_representativeness(v)
    for k, t in mission_tables(linked).items():
        tables[f"la_mission_{k}"] = t
    tables["la_relabel_protocol"] = relabel_protocol()
    tables["la_trl_placeholder"] = trl_placeholder()
    lv = archetype_levels(ds, v)
    tables["la_archetype_levels"] = lv
    tables["la_archetype_choice"] = archetype_level_choice(lv)
    tables["la_dd_conditions"] = dominant_design_conditions()
    tables["la_dominant_design"] = dominant_design(v)
    tables["la_dd_q"] = dominant_design_q(ds, v)
    tables["la_dd_result"] = dominant_design_result(tables["la_dominant_design"], q=tables["la_dd_q"])
    tables["la_class_configs"] = class_configs(v)
    # written to tables/ and read by the propulsive-units figure (panel iii, la_figures.fig_units)
    # and its takeaway; not placed in a node of its own — the figure carries the reading and the
    # CSV keeps every share checkable beside its n. To print it, add "la_duct_units" to the node
    # of la_index.NODES that holds "atlas_units".
    tables["la_duct_units"] = duct_by_units(v)
    tables["la_dimension_drift"] = dimension_drift(v)
    # 1.4 design drivers and their traces (2026-09-23). la_trace_drift and la_trace_trends are
    # written to tables/ and read by Figure 1.4.1 and by the verdict table; they are not placed in
    # a node of their own (35 x 38 and 119 rows). The three printed tables are generated from the
    # trends frame, so the figure, the verdicts and the three answers cannot disagree.
    tables["la_trace_drift"] = trace_drift(ds, v)
    _tt = trace_trends(ds, v)
    tables["la_trace_trends"] = _tt
    tables["la_driver_verdicts"] = driver_verdicts(ds, v, _tt)
    tables["la_driver_questions"] = driver_questions(ds, v, _tt)
    _pairs = trace_couplings(ds, v)
    tables["la_trace_couplings_all"] = _pairs
    tables["la_trace_couplings"] = predicted_couplings(ds, v, _pairs)
    # Built again 2026-09-23 but still not placed in any node: the 12x12 matrix is unreadable as a
    # markdown table (the author's complaint about the table of 1.2.4, which he called "table 4.2.4"
    # before the 2026-09-23 renumbering, is about the figure, which is the
    # matrix), while the takeaway of Figure 1.2.4 reads its pair counts out of this frame and the CSV
    # keeps them checkable. To print it, add "la_transitions" to node 1.2.4 in la_index.NODES.
    tables["la_transitions"] = transitions(v)
    tables["la_ip_strategy"] = ip_strategy(ds, v)
    tables["la_ip_by_class"] = ip_by_class(v, ds)
    tables["la_cohorts"] = cohorts(v)
    tables["la_ari_timeline"] = ari_timeline(v)
    tables["la_ari_clock_region"] = ari_clock_region(v)
    lq, counts = specialisation(v)
    t = lq.copy(); t.insert(0, "aircraft", counts.sum(axis=1))
    tables["la_specialisation"] = t.reset_index()
    tables["la_industry_by_class"] = industry_by_class(v)
    tables["la_examination_office"] = examination(v, "pub_office")
    tables["la_examination_class"] = examination(v, "topType")
    tables["la_powertrain_by_class"] = powertrain_by_class(v)
    tables["la_flags"] = flags()
    tables["la_filings_per_year"] = filings_per_year(ds, v)
    # Appendix C: built from la_index's registers and GRADE, reads no data; last so that every item
    # it can cite already has its number in the same NODES walk the document is numbered by.
    tables["la_open_questions"] = open_questions()
    return tables
