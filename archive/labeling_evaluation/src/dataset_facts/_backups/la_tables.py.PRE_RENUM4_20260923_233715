ASSIGNEE_EXPAND = {
    "tech": "technology", "techn": "technology", "technologies": "technology", "aviat": "aviation",
    "aeronaut": "aeronautics", "aeronautic": "aeronautics", "ind": "industries", "inds": "industries",
