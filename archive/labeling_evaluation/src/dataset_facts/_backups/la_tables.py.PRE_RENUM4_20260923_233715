def _trace_values(sub: pd.DataFrame, key: str) -> pd.Series:
    s = sub[key]
    if TRACE_OF[key]["kind"] == "share":
        return s.map({True: 1.0, False: 0.0}).astype(float)
    return pd.to_numeric(s, errors="coerce").astype(float)


def trace_drift(ds: Dataset, v: pd.DataFrame, classes: Optional[List[str]] = None) -> pd.DataFrame:
    """Per class and window, one column per trace: the share (or median) and the aircraft it
    rests on — the frame behind Figure 1.4.1. Same rules as :func:`dimension_drift`: the drawn
    classes are the 5-in-3-windows rule, a window under :data:`MIN_CELL` aircraft of the class
    keeps its row with the count and blank measures, and a share is a share of the row's aircraft
    that answer the trace (printed beside it as ``<trace> n``), never of rotors. Two pooled rows
    per window follow the classes: the five drawn classes together, and every classed aircraft."""
    classes = classes or drawn_classes(v)
    t = trace_frame(ds, v).dropna(subset=["window", "topType"])
    rows = []
    for code in classes + list(POOLED):
        sub_c = t[t["topType"].eq(code)] if code in classes else (
            t[t["topType"].isin(classes)] if code == "ALL5" else t)
        for name in WINDOW_NAMES:
            sub = sub_c[sub_c["window"].eq(name)]
            row = {"class": metrics.ARCH_NAMES.get(code, POOLED.get(code, code)), "code": code,
                   "window": name, "aircraft": int(len(sub))}
            for tr in TRACES:
                vals = _trace_values(sub, tr["key"]).dropna()
                ok = len(sub) >= MIN_CELL and len(vals) >= MIN_CELL
                row[tr["label"]] = (round(float(vals.mean()), 2) if tr["kind"] == "share" else float(vals.median())) if ok else np.nan
                row[tr["label"] + " n"] = int(len(vals))
            rows.append(row)
    out = pd.DataFrame(rows)
    out.attrs.update(class_selection(v))
    return out


def trace_trends(ds: Dataset, v: pd.DataFrame, classes: Optional[List[str]] = None) -> pd.DataFrame:
    """Did the trace move? One row per trace and class (and the two pooled rows).

    The test is one rule for every trace: Spearman's rho between the priority year and the
    trace over the aircraft of the row with a value and a complete priority year (to
    :data:`LAST_COMPLETE`), read only on :data:`TREND_MIN` aircraft or more; ``movement`` is
    ``rises`` / ``falls`` at p < :data:`TREND_ALPHA`, ``flat`` otherwise, ``too thin`` under the
    floor, ``constant`` when the trace takes one value in the class. Beside it, the value in the
    earliest window holding 10 or more aircraft of the class and the value in 2020-23, so the
    size of the movement is printed with its test. A pooled trend mixes the movement inside the
    classes with the class shift of 1.1.2 and is read as such.
    """
    from scipy import stats as _st
    classes = classes or drawn_classes(v)
    t = trace_frame(ds, v).dropna(subset=["window", "topType"])
    drift = trace_drift(ds, v, classes)
    rows = []
    for tr in TRACES:
        for code in classes + list(POOLED):
            sub_c = t[t["topType"].eq(code)] if code in classes else (
                t[t["topType"].isin(classes)] if code == "ALL5" else t)
            s = pd.DataFrame({"y": pd.to_numeric(sub_c["year"], errors="coerce"),
                              "x": _trace_values(sub_c, tr["key"])}).dropna()
            s = s[s["y"].le(LAST_COMPLETE)]
            d = drift[drift["code"].eq(code)].set_index("window")
            # the earliest reportable window (MIN_CELL or more aircraft with a value — a hollow
            # marker in the figure) and 2020-23, the last complete window
            solid = [w for w in WINDOW_NAMES[:-1] if pd.notna(d.loc[w, tr["label"]])]
            first_w = solid[0] if solid else None
            first = d.loc[first_w, tr["label"]] if first_w else np.nan
            last = d.loc["2020-23", tr["label"]]
            means = {}
            if tr.get("show_mean"):
                for tag, w in (("first mean", first_w), ("2020-23 mean", "2020-23")):
                    vals = _trace_values(sub_c[sub_c["window"].eq(w)], tr["key"]).dropna() if w else pd.Series(dtype=float)
                    means[tag] = round(float(vals.mean()), 2) if len(vals) >= MIN_CELL else np.nan
            row = {"trace": tr["label"], "driver kind": DRIVERS[next(iter(tr["drivers"]))][0],
                   "class": metrics.ARCH_NAMES.get(code, POOLED.get(code, code)), "code": code,
                   "aircraft": int(len(s)), "first window": first_w or "", "first value": first,
                   "2020-23 value": last, "first mean": means.get("first mean", np.nan),
                   "2020-23 mean": means.get("2020-23 mean", np.nan), "rho": np.nan, "p": np.nan}
            if len(s) < TREND_MIN:
                row["movement"] = "too thin"
            elif s["x"].nunique() < 2:
                row["movement"] = "constant"
            else:
                rho, p = _st.spearmanr(s["y"], s["x"])
                row["rho"], row["p"] = round(float(rho), 2), float(p)
                row["movement"] = ("rises" if rho > 0 else "falls") if p < TREND_ALPHA else "flat"
            rows.append(row)
    out = pd.DataFrame(rows)
    out.attrs.update(class_selection(v))
    return out


def _fmt_val(x, kind: str) -> str:
    if pd.isna(x):
        return "–"
    return f"{x:.0%}" if kind == "share" else f"{x:g}"


def _span(r: pd.Series, kind: str) -> str:
    """``first → last`` for one trends row; a median prints its mean beside it, because a median
    of small integers can stand still while the distribution moves."""
    out = f"{_fmt_val(r['first value'], kind)} → {_fmt_val(r['2020-23 value'], kind)}"
    if pd.notna(r.get("first mean")) and pd.notna(r.get("2020-23 mean")):
        out += f", mean {r['first mean']:.1f} → {r['2020-23 mean']:.1f}"
    return out


def _fmt_p(p: float) -> str:
    if pd.isna(p):
        return ""
    return "p < 0.001" if p < 0.001 else f"p {p:.2f}" if p >= 0.01 else f"p {p:.3f}"


def _moved_text(tr: Dict, tt: pd.DataFrame) -> Tuple[str, str]:
    """(what moved, direction) for one trace out of the trends frame: the classes that rise or
    fall with their first and 2020-23 values and the test, then the flat ones, then the pooled
    row. ``direction`` is ``+`` / ``-`` when at least one class or the pooled rows move that way
    and none the other way, ``mixed`` when classes move both ways, ``0`` when nothing moves."""
    k = tr["kind"]
    sub = tt[tt["trace"].eq(tr["label"])].set_index("code")
    cls = [c for c in sub.index if c not in POOLED]
    moved = [c for c in cls if sub.loc[c, "movement"] in ("rises", "falls")]
    flat = [c for c in cls if sub.loc[c, "movement"] == "flat"]
    thin = [c for c in cls if sub.loc[c, "movement"] in ("too thin", "constant")]
    parts = []
    for c in moved:
        r = sub.loc[c]
        parts.append(f"{r['movement']} in {c} ({_span(r, k)}, {WIN_SHORT.get(r['first window'], r['first window'])} to 20–23, "
                     f"ρ {r['rho']:+.2f}, {_fmt_p(r['p'])})")
    if flat:
        parts.append("flat in " + ", ".join(f"{c} ({_span(sub.loc[c], k)})" for c in flat))
    if thin:
        parts.append("no trend readable in " + ", ".join(f"{c} ({sub.loc[c, 'movement']})" for c in thin))
    p5 = sub.loc["ALL5"]
    pooled = (f"pooled over the five classes: {p5['movement']} ({_span(p5, k)}"
              + (f", ρ {p5['rho']:+.2f}, {_fmt_p(p5['p'])})" if pd.notna(p5['rho']) else ")"))
    text = "; ".join(parts) + "; " + pooled
    ups = [c for c in moved if sub.loc[c, "movement"] == "rises"] + (["ALL5"] if p5["movement"] == "rises" else [])
    downs = [c for c in moved if sub.loc[c, "movement"] == "falls"] + (["ALL5"] if p5["movement"] == "falls" else [])
    direction = "mixed" if ups and downs else "+" if ups else "-" if downs else "0"
    return text, direction


def _driver_name(code: str) -> str:
    kind, name = DRIVERS[code]
    return f"{name} ({kind})"


def driver_verdicts(ds: Dataset, v: pd.DataFrame, trends: Optional[pd.DataFrame] = None) -> pd.DataFrame:
    """The verdict table — one row per trace, generated from :func:`trace_trends` so the table and
    the figure cannot disagree: what moved (with the numbers, per class where it differs), the
    drivers that predict the trace, and the verdict. Verdicts: ``single driver`` (one driver
    predicts the movement seen), ``overdetermined (n drivers)`` (several predict it and the
    record cannot separate them), ``opposed drivers`` (the drivers predict opposite directions
    — the row says which way the trace went), ``trace does not move`` (no class and no pooled
    row moves, so the drivers leave no trend to read), ``mixed by class`` (classes move both
    ways), and ``not labelled`` for the traces the label set does not carry."""
    tt = trends if trends is not None else trace_trends(ds, v)
    rows = []
    for tr in TRACES:
        moved, direction = _moved_text(tr, tt)
        drv = tr["drivers"]
        names = ", ".join(_driver_name(c) + (f" {s}" if s in "+-" else "") for c, s in drv.items())
        # a fixed physical driver (A2) predicts a coupling, never a trend: it is not a candidate
        # for a movement, and a trace only A2 drivers predict is read in the coupling test instead
        moving = {c: s for c, s in drv.items() if DRIVERS[c][0] != "A2"}
        fixed = [c for c in drv if DRIVERS[c][0] == "A2"]
        n_drv = len(drv)
        signs = set(moving.values())
        if direction == "0":
            verdict = f"trace does not move ({n_drv} driver{'s' if n_drv > 1 else ''} predict{'' if n_drv > 1 else 's'} it; none is tested by a trend)"
        elif direction == "mixed":
            verdict = "mixed by class — the classes move in opposite directions; no single-driver reading"
        elif not moving:
            verdict = ("moves, but only fixed physical drivers predict this trace — they predict a coupling, not a "
                       "trend, and are read in the coupling test (1.4.2); the movement is not a driver trace the "
                       "frame can read")
        elif "+" in signs and "-" in signs:
            with_ = [c for c, s in moving.items() if s == direction or s == "±"]
            against = [c for c, s in moving.items() if s in "+-" and s != direction]
            verdict = (f"opposed drivers — the trace went with {', '.join(_driver_name(c) for c in with_)} "
                       f"and against {', '.join(_driver_name(c) for c in against)}")
        else:
            consistent = [c for c, s in moving.items() if s == direction or s == "±"]
            if len(consistent) == 1:
                verdict = f"single driver — {_driver_name(consistent[0])}"
            elif len(consistent) == 0:
                verdict = ("moved against every driver that predicts a direction — "
                           + ", ".join(_driver_name(c) + f" predicts {'more' if s == '+' else 'fewer'}" for c, s in moving.items()))
            else:
                verdict = (f"overdetermined ({len(consistent)} drivers) — " + ", ".join(_driver_name(c) for c in consistent)
                           + "; the record cannot say which")
            if fixed:
                verdict += f"; {', '.join(_driver_name(c) for c in fixed)} fixed, coupling only"
        rows.append({"trace": tr["label"] + ("" if tr["kind"] == "share" else " (median)"),
                     "driver kind": DRIVER_KIND_NAMES[DRIVERS[next(iter(drv))][0]],
                     "where drawn": ("Figure 1.1.5" if tr.get("from_215") else "Figure 1.4.1" if tr.get("drawn") else "tables only"),
                     "what moved": moved, "drivers that predict it": names, "verdict": verdict})
    for name, codes in UNLABELLED_TRACES:
        rows.append({"trace": name, "driver kind": DRIVER_KIND_NAMES[DRIVERS[codes.split(",")[0].strip()][0]],
                     "where drawn": "—", "what moved": "not labelled: no field of the codebook carries it",
                     "drivers that predict it": ", ".join(_driver_name(c.strip()) for c in codes.split(",")),
                     "verdict": "not labelled — see Appendix C"})
    out = pd.DataFrame(rows)
    out["verdict class"] = out["verdict"].map(lambda t: t.split(" —")[0].split(" (")[0].strip())
    out.attrs["labelled"] = len(TRACES)
    return out


